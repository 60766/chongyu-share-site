# 生产环境配置
NODE_ENV=production
PORT=3000

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PROVIDER_ENDPOINT=https://api.deepseek.com/v1/chat/completions
PROVIDER_MODEL=deepseek-chat

# 备用API配置
FALLBACK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
FALLBACK_API_KEY=your_fallback_api_key_here

# 积分配置
CREDITS_PER_1K_TOKENS=100

# 安全配置
JWT_SECRET=your_jwt_secret_here_please_change_this_in_production

# iOS 应用 Bundle ID
APP_BUNDLE_ID=com.shilong111234.chongyu

# 是否使用模拟API（生产环境设为0）
MOCK_PROVIDER=0 