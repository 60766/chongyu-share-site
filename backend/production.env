FALLBACK_API_KEY=5ec25df2-f799-4fc0-8ee2-ac13d473131b

# 积分配置（方案A：确保盈利的费率）
# 计算依据：
# - 文本API成本：¥0.0136/1K tokens（基于真实数据：输入¥0.004/1K，输出¥0.016/1K，平均1:4比例）
# - 视觉API成本：¥0.0014/1K tokens（基于真实数据）
# - 用户充¥6 = 1800虫洞币，扣除Apple 30%抽成后实际收入¥4.2
# - 目标：1800虫洞币 = ¥3的API tokens价值（确保盈利，利润率约28%）
# - 文本新费率：1800÷(3÷0.0136) = 8.16 ≈ 8.2 虫洞币/1K tokens
# - 视觉新费率：1800÷(3÷0.0014) = 0.84 虫洞币/1K tokens
# - 文本可用tokens：1800÷8.2×1000 ≈ 219,512 tokens（API成本¥2.99）
# - 视觉可用tokens：1800÷0.84×1000 ≈ 2,142,857 tokens（API成本¥3.00）
# - 扣除Apple 30%抽成后，实际收入¥4.2，API成本¥3，净利润¥1.2，利润率28.6%
CREDITS_PER_1K_TOKENS=1.7  # 废弃，保留用于兼容
CREDITS_TEXT_PER_1K_TOKENS=8.2  # 文本API费率（确保盈利）
CREDITS_VISION_PER_1K_TOKENS=0.84  # 视觉API费率（确保盈利）

# 安全配置
JWT_SECRET=ChongYu_Production_JWT_Secret_2025_v1.0_Secure_Key_For_Apple_Store

# iOS 应用 Bundle ID
APP_BUNDLE_ID=com.lishilong.chongyu

# IAP验证配置
# IAP_VERIFY_STRICT: 是否启用严格模式（1=启用，0=禁用）
# - 严格模式：验证失败直接拒绝交易
# - 非严格模式：验证失败记录警告但继续处理（向后兼容）
# 建议：生产环境设为1（严格模式），开发/测试环境设为0（非严格模式）
IAP_VERIFY_STRICT=0

# 新账号初始赠送虫洞币（未设置时默认600）
INITIAL_WELCOME_CREDITS=600

# 是否使用模拟API（生产环境设为0）
MOCK_PROVIDER=0
