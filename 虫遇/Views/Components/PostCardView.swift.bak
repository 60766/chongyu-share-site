            .padding(.vertical, 4.0)    // 统一垂直内边距
            .background(getCharacterColor(for: characterID).opacity(0.1))
            .foregroundColor(getCharacterColor(for: characterID))
            .cornerRadius(6.0)          // 统一圆角大小
    }
    
