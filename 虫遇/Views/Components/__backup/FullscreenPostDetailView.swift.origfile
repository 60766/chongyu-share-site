import SwiftUI
import UIKit
import Combine

/**
 * 全屏沉浸式帖子详情视图
 * 提供沉浸式阅读和评论体验，支持多种手势导航和状态反馈
 */
struct FullscreenPostDetailView: View {
    // 帖子数据
    let post: UserPostModel
    
    // 上下文数据
    var currentIndex: Int? = nil
    var totalCount: Int? = nil
    
    // 回调函数
    var onDismiss: () -> Void = {}
    var onNextPost: (() -> Void)? = nil
    var onPreviousPost: (() -> Void)? = nil
    var onLikeComment: ((UserPostModel, UserCommentModel) -> Void)? = nil
    var onAddComment: ((UserPostModel, String, UUID?) -> Void)? = nil
    
    // 状态管理
    @Environment(\.presentationMode) private var presentationMode
    @ObservedObject private var tabBarManager = TabBarManager.shared
    @State private var showShareSheet = false
    @State private var commentText: String = ""
    @State private var replyingTo: UserCommentModel? = nil
    @State private var scrollOffset: CGFloat = 0
    @State private var showNavBar: Bool = true
    @State private var isKeyboardVisible: Bool = false
    @State private var isFullImmersiveMode: Bool = false
    @State private var showEmojiPicker: Bool = false
    @State private var dragOffset: CGSize = .zero
    @State private var showEdgePreview: Bool = false
    @State private var showGestureTip: Bool = true
    @State private var scrollToCommentSection: Bool = false
    @State private var navBarOpacity: CGFloat = 0.0
    
    // 添加过渡动画状态
    @State private var transitionState: TransitionState = .none
    
    // 触觉反馈
    private let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
    
    // 过渡状态枚举
    private enum TransitionState {
        case none
        case transitioning(direction: TransitionDirection, targetPost: UserPostModel)
        case dismissing
        
        enum TransitionDirection {
            case left, right
        }
    }
    
    var body: some View {
        // 使用更清晰的嵌套结构
        ZStack(alignment: .bottom) {
            // 背景
            Color(UIColor.systemBackground)
                .edgesIgnoringSafeArea(.all)
            
            // 主内容区域
            GeometryReader { outerGeometry in
                if isFullImmersiveMode {
                    // 全屏模式内容
                    FullscreenContentView(
                        post: post,
                        scrollOffset: $scrollOffset,
                        scrollToCommentSection: $scrollToCommentSection,
                        dragOffset: $dragOffset,
                        contentOpacity: contentOpacity,
                        onLike: { comment in
                            onLikeComment?(post, comment)
                        },
                        onReply: { comment in
                            replyingTo = comment
                            // 从全屏模式切换回普通模式以显示评论输入框
                            if isFullImmersiveMode {
                                isFullImmersiveMode = false
                            }
                        },
                        onTapGesture: handleDoubleTap
                    )
                    .edgesIgnoringSafeArea(.all)
                    .gesture(navigationGesture)
                    .overlay(gestureHintOverlay)
                    .overlay(edgePreviewOverlay)
                } else {
                    // 常规模式内容
                    VStack(spacing: 0) {
                        // 自定义导航栏
                        HStack {
                            // 返回按钮
                            backButton
                            
                            Spacer()
                            
                            // 标题
                            titleView
                            
                            Spacer()
                            
                            // 分享按钮
                            shareButton
                        }
                        .padding(.horizontal, 16)
                        .padding(.top, 12)
                        .padding(.bottom, 8)
                        .background(
                            Rectangle()
                                .fill(Color.white.opacity(scrollOffset > 20 ? 0.98 : 1.0))
                                .shadow(color: Color.black.opacity(scrollOffset > 20 ? 0.05 : 0), radius: 8, x: 0, y: 4)
                        )
                        
                        // 主内容区域 - 为评论输入栏增加足够的底部边距
                        mainContentArea
                            .padding(.bottom, 120) // 从100增加到120，确保不被评论输入框遮挡
                    }
                }
            }
            
            // 评论输入框 - 总是位于底部且有最高 Z 索引
            // 仅在非全屏模式下显示
            if !isFullImmersiveMode {
                CommentInputBar(
                    commentText: $commentText,
                    onSendComment: { comment in
                        // 处理发送评论逻辑
                        addComment(content: comment, replyToID: replyingTo?.id)
                        // 重置回复状态
                        replyingTo = nil
                    }
                )
                .shadow(color: Color.black.opacity(0.1), radius: 4, y: -2)
                // 处理回复状态变化
                .onChange(of: replyingTo) { oldValue, newValue in
                    if newValue != nil {
                        // 自动滚动到评论区域
                        scrollToCommentSection = true
                        
                        // 使用延迟确保视图已更新后再聚焦
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
                            // 这里需要设置 CommentInputBar 内部的 isInputFocused 为 true
                            // 通过 NSNotificationCenter 广播一个自定义事件来实现
                            NotificationCenter.default.post(
                                name: Notification.Name("FocusCommentInput"),
                                object: nil
                            )
                        }
                    }
                }
            }
        }
        .statusBar(hidden: isFullImmersiveMode)
        .ignoresSafeArea(.all, edges: .all)
        .onAppear {
            // 隐藏TabBar
            tabBarManager.completelyHide()
            
            // 强制隐藏 Home Indicator 以增强沉浸感
            tabBarManager.setHomeIndicatorAutoHidden(true)
            
            // 额外设置 - 确保 Home Indicator 被尽可能隐藏
            DispatchQueue.main.async {
                // 使用 UIKit 方法隐藏 Home Indicator
                if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
                   let window = windowScene.windows.first,
                   let rootViewController = window.rootViewController {
                    // 遍历所有视图控制器尝试隐藏 Home Indicator
                    let _ = rootViewController.children.map { viewController in
                        viewController.setNeedsUpdateOfHomeIndicatorAutoHidden()
                        viewController.setNeedsUpdateOfScreenEdgesDeferringSystemGestures()
                    }
                    
                    // 强制刷新视图层级
                    window.layoutIfNeeded()
                }
            }
            
            setupOnAppear()
            
            // 额外配置：确保ScrollView可以延伸到底部
            // 设置UIScrollView的全局配置
            UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
            UIScrollView.appearance().automaticallyAdjustsScrollIndicatorInsets = false
            
            // 关键改进：手动获取UIWindow并禁用安全区域
            DispatchQueue.main.async {
                if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
                   let window = windowScene.windows.first {
                    // 递归处理视图层级中的安全区域
                    disableSafeAreaInViewHierarchy(window)
                }
            }
        }
        .onDisappear {
            // 恢复TabBar显示
            tabBarManager.show()
            
            // 恢复Home Indicator显示
            tabBarManager.setHomeIndicatorAutoHidden(false)
            
            // 还原ScrollView默认设置
            UIScrollView.appearance().contentInsetAdjustmentBehavior = .automatic
            UIScrollView.appearance().automaticallyAdjustsScrollIndicatorInsets = true
        }
        .sheet(isPresented: $showShareSheet) {
            // 分享菜单
            ActivityView(activityItems: [
                "查看来自「虫遇」的分享：\(post.content.prefix(40))..."
            ])
        }
        .onChange(of: scrollOffset) { oldValue, newValue in
            // 根据滚动位置更新导航栏显示状态
            withAnimation(.easeOut(duration: 0.2)) {
                navBarOpacity = min(1.0, scrollOffset / 200)
            }
        }
    }
    
    // MARK: - 子视图组件
    
    // 主内容区域
    private var mainContentArea: some View {
        GeometryReader { geometry in
            ScrollViewReader { scrollProxy in
                ScrollView {
                    // 滚动位置检测
                    scrollPositionDetector
                    
                    // 内容区
                    VStack(spacing: 0) {
                        // 帖子内容部分 - 使用当前应显示的帖子
                        // 使用计算属性决定显示内容，而不是通过id触发重建
                        makePostContentSection(for: currentDisplayPost)
                            .id("postContent")
                        
                        // 分隔线
                        Rectangle()
                            .fill(Color(UIColor.systemGroupedBackground))
                            .frame(height: 8)
                        
                        // 评论区部分 - 使用当前应显示的帖子
                        makeCommentsSection(for: currentDisplayPost)
                            .id("comments")
                        
                        // 底部空间 - 为键盘、输入区和TabBar预留足够空间
                        // 使用更小的底部间距，确保内容能延伸到底部
                        if !isFullImmersiveMode {
                            // 现在TabBar已完全隐藏，所以这里只需要考虑输入区域所需的空间
                            Spacer(minLength: 120)
                                .frame(height: 120)
                                .id("bottomSpacer")
                        } else {
                            // 全屏模式下没有任何底部空间
                            EmptyView()
                        }
                    }
                    .padding(.top, isFullImmersiveMode ? 0 : (showNavBar ? 44 : 0))
                    .opacity(contentOpacity)
                    .offset(x: getContentOffset())
                }
                .onAppear {
                    if isFullImmersiveMode {
                        // 确保全屏模式下内容能滚动到底部
                        UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
                    }
                }
                .onDisappear {
                    // 恢复默认行为
                    UIScrollView.appearance().contentInsetAdjustmentBehavior = .automatic
                }
                .coordinateSpace(name: "scrollView")
                .onPreferenceChange(ScrollOffsetPreferenceKey.self) { offset in
                    handleScrollOffsetChange(offset)
                }
                .onChange(of: scrollToCommentSection) { _, newValue in
                    if newValue {
                        withAnimation {
                            scrollProxy.scrollTo("comments", anchor: .top)
                        }
                        scrollToCommentSection = false
                    }
                }
                // 在帖子切换后滚动到顶部
                .onChange(of: post.id) { _, _ in
                    withAnimation {
                        scrollProxy.scrollTo("postContent", anchor: .top)
                    }
                }
                // 在全屏模式变化时响应
                .onChange(of: isFullImmersiveMode) { _, newValue in
                    // 调整ScrollView的行为
                    UIScrollView.appearance().contentInsetAdjustmentBehavior = newValue ? .never : .automatic
                }
            }
        }
        .gesture(navigationGesture)
        .onTapGesture(count: 2) {
            handleDoubleTap()
        }
        .overlay(gestureHintOverlay)
        .overlay(edgePreviewOverlay)
        .edgesIgnoringSafeArea(.all) // 确保内容延伸到所有边缘
    }
    
    // 滚动位置检测器
    private var scrollPositionDetector: some View {
        GeometryReader { innerGeometry in
            Color.clear.preference(
                key: ScrollOffsetPreferenceKey.self,
                value: innerGeometry.frame(in: .named("scrollView")).minY
            )
        }
        .frame(height: 0)
    }
    
    // 返回按钮视图
    private var backButton: some View {
        Button(action: { dismiss() }) {
            ZStack {
                Circle()
                    .fill(Color.black.opacity(0.1))
                    .frame(width: 36, height: 36)
                
                Image(systemName: "xmark")
                    .font(.system(size: 16, weight: .medium))
                    .foregroundColor(.primary)
            }
        }
        .buttonStyle(PlainButtonStyle())
    }
    
    // 标题视图
    private var titleView: some View {
        Group {
            if showNavBar && !isFullImmersiveMode {
                HStack {
                    Text("动态详情")
                        .font(.headline)
                    
                    if let current = currentIndex, let total = totalCount {
                        Text("(\(current)/\(total))")
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                            .padding(.horizontal, 8)
                            .padding(.vertical, 2)
                            .background(Color.gray.opacity(0.1))
                            .cornerRadius(12)
                    }
                }
            }
        }
    }
    
    // 分享按钮
    private var shareButton: some View {
        Button(action: {
            showShareSheet = true
        }) {
            Image(systemName: "square.and.arrow.up")
                .foregroundColor(.primary)
        }
    }
    
    // 导航手势
    private var navigationGesture: some Gesture {
        DragGesture(minimumDistance: 20, coordinateSpace: .global)
            .onChanged { value in
                handleDragGestureChange(value)
            }
            .onEnded { value in
                handleDragGestureEnd(value)
            }
    }
    
    // 手势提示覆盖层
    private var gestureHintOverlay: some View {
        Group {
            if showGestureTip {
                VStack {
                    Spacer()
                    
                    HStack(spacing: 24) {
                        if onPreviousPost != nil && onNextPost != nil {
                            // 如果有上一条和下一条，显示左右滑动切换提示
                            Label("左右滑动切换", systemImage: "arrow.left.and.right")
                        } else if onPreviousPost == nil && onNextPost != nil {
                            // 如果是第一条，只显示向左滑动查看下一条
                            Label("向左滑动查看下一条", systemImage: "arrow.right")
                        } else if onPreviousPost != nil && onNextPost == nil {
                            // 如果是最后一条，只显示向右滑动查看上一条
                            Label("向右滑动查看上一条", systemImage: "arrow.left")
                        } else {
                            // 否则只显示右滑关闭提示
                            Label("右滑关闭", systemImage: "chevron.backward")
                        }
                        
                        Label("双击全屏", systemImage: "arrow.up.left.and.arrow.down.right")
                    }
                    .font(DesignSystem.Typography.footnote)
                    .padding(.horizontal, 16)
                    .padding(.vertical, 8)
                    .background(Color.black.opacity(0.7))
                    .foregroundColor(.white)
                    .cornerRadius(20)
                    .padding(.bottom, 40)
                }
                .transition(.opacity)
            }
        }
        .animation(.easeInOut(duration: 0.2), value: showGestureTip)
    }
    
    // 边缘预览指示器覆盖层
    private var edgePreviewOverlay: some View {
        Group {
            if showEdgePreview {
                HStack {
                    if dragOffset.width > 0 {
                        if onPreviousPost != nil {
                            // 右滑预览指示 - 上一条
                            HStack {
                                Image(systemName: "chevron.left")
                                Text("上一条")
                            }
                            .transition(.opacity)
                            .padding(.horizontal, 16)
                            .padding(.vertical, 8)
                            .background(Color.white.opacity(0.7))
                            .cornerRadius(20)
                            .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                            .padding(.leading, 20)
                        } else {
                            // 右滑关闭指示
                            HStack {
                                Image(systemName: "xmark.circle")
                                Text("关闭")
                            }
                            .transition(.opacity)
                            .padding(.horizontal, 16)
                            .padding(.vertical, 8)
                            .background(Color.white.opacity(0.7))
                            .cornerRadius(20)
                            .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                            .padding(.leading, 20)
                        }
                        
                        Spacer()
                    } else if dragOffset.width < 0 && onNextPost != nil {
                        // 左滑预览指示 - 只有在有下一篇帖子时才显示
                        Spacer()
                        
                        HStack {
                            Text("下一条")
                            Image(systemName: "chevron.right")
                        }
                        .transition(.opacity)
                        .padding(.horizontal, 16)
                        .padding(.vertical, 8)
                        .background(Color.white.opacity(0.7))
                        .cornerRadius(20)
                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                        .padding(.trailing, 20)
                    } else if dragOffset.width < 0 && onNextPost == nil {
                        // 已经是最后一篇帖子，显示提示
                        Spacer()
                        
                        HStack {
                            Text("已是最后一条")
                            Image(systemName: "exclamationmark.circle")
                        }
                        .transition(.opacity)
                        .padding(.horizontal, 16)
                        .padding(.vertical, 8)
                        .background(Color.white.opacity(0.7))
                        .cornerRadius(20)
                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                        .padding(.trailing, 20)
                    }
                }
                .frame(maxWidth: .infinity)
                .padding(.top, 100)
            }
        }
    }
    
    // 评论输入区域
    private var commentInputArea: some View {
        VStack(spacing: 0) {
            Divider()
            
            // 评论输入组件
            CommentBar(
                text: $commentText,
                placeholder: replyingTo == nil ? "发表评论..." : "回复 \(replyingTo?.username ?? "")...",
                onSend: {
                    handleSendComment()
                },
                activateImmediately: replyingTo != nil,
                showEmojiPicker: $showEmojiPicker
            )
            .frame(height: 50)
            
            // 表情选择器
            if showEmojiPicker {
                EmojiPickerView(text: $commentText)
                    .transition(.opacity)
            }
        }
        .background(
            // 移除模糊背景，使用纯色背景
            Color(UIColor.systemBackground)
                .shadow(color: Color.black.opacity(0.05), radius: 3, y: -2)
        )
        .animation(.linear(duration: 0.2), value: showEmojiPicker)
        // 根据内容状态调整评论栏可见性
        .opacity(commentBarOpacity)
        // 重要修改：不再加入底部安全区域的padding
        // 确保评论栏始终位于底部，不会被底部安全区域遮挡
        .padding(.bottom, 0)
        // 全屏模式下，使用zIndex确保不占用空间
        .zIndex(isFullImmersiveMode ? -1 : 1)
        // 全屏模式下完全禁用视图
        .disabled(isFullImmersiveMode)
    }
    
    // MARK: - 事件处理方法
    
    // 处理滚动偏移变化
    private func handleScrollOffsetChange(_ offset: CGFloat) {
        withAnimation(.easeOut) {
            scrollOffset = -offset
            
            // 向下滚动时隐藏导航栏
            if scrollOffset > 20 && offset < 0 {
                showNavBar = false
            } else if offset > 0 || scrollOffset < 10 {
                // 回到顶部或微小滚动时显示导航栏
                showNavBar = true
            }
        }
    }
    
    // 初始设置
    private func setupOnAppear() {
        // 准备触觉反馈
        feedbackGenerator.prepare()
        
        // 重置评论框状态
        commentText = ""
        replyingTo = nil
        
        // 设置初始滚动位置
        scrollOffset = 0
        
        // 显示手势提示，然后自动隐藏
        showGestureTip = true
        DispatchQueue.main.asyncAfter(deadline: .now() + 3) {
            withAnimation {
                showGestureTip = false
            }
        }
        
        // 确保在初始化时输入框可见
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.1) {
            // 发送布局刷新通知
            NotificationCenter.default.post(
                name: NSNotification.Name("RefreshCommentInputLayout"),
                object: nil
            )
        }
    }
    
    // 处理双击
    private func handleDoubleTap() {
        withAnimation(.spring(response: 0.3, dampingFraction: 0.7)) {
            isFullImmersiveMode.toggle()
            
            // 全屏模式时需要立即隐藏状态栏及底部安全区域
            if isFullImmersiveMode {
                // 更改ScrollView的contentInsetAdjustmentBehavior以忽略安全区域
                UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
            } else {
                // 恢复默认行为
                UIScrollView.appearance().contentInsetAdjustmentBehavior = .automatic
            }
        }
        
        // 触觉反馈
        let feedbackType: UIImpactFeedbackGenerator.FeedbackStyle = isFullImmersiveMode ? .rigid : .light
        let feedback = UIImpactFeedbackGenerator(style: feedbackType)
        feedback.impactOccurred()
    }
    
    // 处理拖动手势变化
    private func handleDragGestureChange(_ value: DragGesture.Value) {
        // 计算拖动的方向和距离
        dragOffset = value.translation
        
        // 仅在水平拖动时显示边缘预览
        if abs(dragOffset.width) > abs(dragOffset.height) && abs(dragOffset.width) > 50 {
            if !showEdgePreview {
                showEdgePreview = true
                
                // 轻微触觉反馈
                let lighterFeedback = UIImpactFeedbackGenerator(style: .light)
                lighterFeedback.impactOccurred(intensity: 0.5)
            }
        } else {
            showEdgePreview = false
        }
    }
    
    // 处理拖动手势结束
    private func handleDragGestureEnd(_ value: DragGesture.Value) {
        let translation = value.translation
        let velocity = value.predictedEndTranslation.width - translation.width
        
        // 如果拖动不够，或者垂直拖动大于水平拖动，则复位
        if abs(translation.width) < 60 && abs(velocity) < 300 || abs(translation.width) < abs(translation.height) {
            // 复位动画
            withAnimation(.spring(response: 0.3, dampingFraction: 0.7)) {
                dragOffset = .zero
                showEdgePreview = false
            }
            return
        }
        
        // 触觉反馈
        let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
        feedbackGenerator.impactOccurred()
        
        // 存储导航动作
        var targetPostAction: (() -> Void)? = nil
        
        if translation.width > 0 {
            // 向右滑动查看上一篇帖子或关闭
            // 如果没有显示任何上一篇帖子的回调，则关闭视图
            if onPreviousPost == nil {
                // 关闭当前视图
                onDismiss()
                return
            }
            
            if let previousPostCallback = onPreviousPost {
                // 从父视图获取上一篇
                targetPostAction = previousPostCallback
            } else {
                return // 无上一篇
            }
        } else {
            // 向左滑动查看下一篇帖子
            if let nextPostCallback = onNextPost {
                // 从父视图获取下一篇
                targetPostAction = nextPostCallback
            } else {
                return // 无下一篇
            }
        }
        
        // 执行目标帖子变更（在父视图中切换到上一篇/下一篇）
        targetPostAction?()
        
        // 动画滑动到新位置
        withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
            dragOffset = .zero
        }
        
        // 动画完成后重置状态
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) {
            self.scrollOffset = 0
            self.showEdgePreview = false
        }
    }
    
    // 生成指定帖子的内容区域
    private func makePostContentSection(for currentPost: UserPostModel) -> some View {
        VStack(alignment: .leading, spacing: DesignSystem.Spacing.l) {
            // 用户信息栏 - 提高视觉层级，增强区分度
            HStack(spacing: DesignSystem.Spacing.m) {
                // 用户头像 - 增大尺寸增强存在感
                Image(currentPost.userAvatar)
                    .resizable()
                    .aspectRatio(contentMode: .fill)
                    .frame(width: 48, height: 48)
                    .clipShape(Circle())
                    .overlay(Circle().stroke(DesignSystem.Colors.primary.opacity(0.2), lineWidth: 2))
                    .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                
                VStack(alignment: .leading, spacing: 4) {
                    // 用户名 - 增强视觉权重
                    Text(currentPost.username)
                        .font(DesignSystem.Typography.title3.weight(.semibold))
                        .foregroundColor(DesignSystem.Colors.primaryText)
                    
