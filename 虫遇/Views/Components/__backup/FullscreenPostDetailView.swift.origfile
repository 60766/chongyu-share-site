    // 生成指定帖子的评论区域
    private func makeCommentsSection(for currentPost: UserPostModel) -> some View {
        // 评论区标题和内容
        VStack(alignment: .leading, spacing: 0) {
            // 评论区标题 - 增强视觉层次和信息区分
            HStack(spacing: DesignSystem.Spacing.s) {
                Image(systemName: "text.bubble.fill")
                    .foregroundColor(DesignSystem.Colors.primary)
                    .font(.system(size: 20))
                
                Text("全部评论")
                    .font(DesignSystem.Typography.title3.weight(.semibold))
                    .foregroundColor(DesignSystem.Colors.primaryText)
                
                Text("(\(currentPost.comments.count))")
                    .font(DesignSystem.Typography.title3)
                    .padding(.horizontal, 8)
                    .padding(.vertical, 2)
                    .background(DesignSystem.Colors.primary.opacity(0.1))
                    .foregroundColor(DesignSystem.Colors.primary)
                    .cornerRadius(12)
                
                Spacer()
                
                // 添加排序选项按钮
                Menu {
                    Button(action: {
                        // 按最新排序
                    }) {
                        Label("最新", systemImage: "arrow.up")
                    }
                    
                    Button(action: {
                        // 按热度排序
                    }) {
                        Label("热度", systemImage: "flame")
                    }
                } label: {
                    HStack(spacing: 4) {
                        Text("最新")
                            .font(DesignSystem.Typography.subheadline)
                        Image(systemName: "chevron.down")
                            .font(.system(size: 12))
                    }
                    .foregroundColor(DesignSystem.Colors.secondaryText)
                    .padding(.horizontal, 10)
                    .padding(.vertical, 6)
                    .background(Color.gray.opacity(0.1))
                    .cornerRadius(16)
                }
            }
            .padding(.horizontal, DesignSystem.Spacing.l)
            .padding(.vertical, DesignSystem.Spacing.m)
            
            // 分隔线
            Divider()
                .padding(.horizontal, DesignSystem.Spacing.l)
            
            if currentPost.comments.isEmpty {
                // 空评论状态 - 更吸引人的空状态设计
                VStack(spacing: DesignSystem.Spacing.l) {
                    Image(systemName: "bubble.left.and.text.bubble.right")
                        .font(.system(size: 40))
                        .foregroundColor(Color.gray.opacity(0.3))
                        .padding()
                        .background(Color.gray.opacity(0.05))
                        .clipShape(Circle())
                    
                    VStack(spacing: DesignSystem.Spacing.s) {
                        Text("还没有评论")
                            .font(DesignSystem.Typography.title3)
                            .foregroundColor(DesignSystem.Colors.primaryText)
                        
                        Text("快来发表第一条评论吧!")
                            .font(DesignSystem.Typography.body)
                            .foregroundColor(DesignSystem.Colors.secondaryText)
                    }
                    
                    Button(action: {
                        // 聚焦到评论输入框
                        let localFeedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                        localFeedbackGenerator.impactOccurred(intensity: 0.5)
                        // 触发评论输入框聚焦
                        NotificationCenter.default.post(
                            name: Notification.Name("FocusCommentInput"),
                            object: nil
                        )
                    }) {
                        Text("发表评论")
                            .font(DesignSystem.Typography.body.weight(.medium))
                            .padding(.horizontal, 24)
                            .padding(.vertical, 12)
                            .background(DesignSystem.Colors.primary)
                            .foregroundColor(.white)
                            .cornerRadius(24)
                            .shadow(color: DesignSystem.Colors.primary.opacity(0.3), radius: 3, x: 0, y: 2)
                    }
                    .buttonStyle(ScaleButtonStyle())
                }
                .frame(maxWidth: .infinity)
                .padding(.vertical, 60)
            } else {
                // 评论列表 - 使用顶级的增强评论列表视图
                EnhancedCommentsListView(
                    comments: currentPost.comments,
                    onReply: { comment in
                        // 触发评论回复回调
                        replyingTo = comment
                        // 从全屏模式切换回普通模式以显示评论输入框
                        if isFullImmersiveMode {
                            isFullImmersiveMode = false
                        }
                        // 触觉反馈
                        let generator = UIImpactFeedbackGenerator(style: .medium)
                        generator.impactOccurred(intensity: 0.4)
                    },
                    onLike: { comment in
                        // 触发点赞回调
                        onLikeComment?(post, comment)
                        // 触觉反馈
                        let generator = UIImpactFeedbackGenerator(style: .medium)
                        generator.impactOccurred(intensity: 0.4)
                    }
                )
                .padding(.horizontal, DesignSystem.Spacing.m)
            }
        }
        .background(
            RoundedRectangle(cornerRadius: DesignSystem.Radius.xl)
                .fill(DesignSystem.Colors.cardBackground)
                .shadow(color: Color.black.opacity(0.05), radius: 2, x: 0, y: 1)
        )
        .padding(.top, DesignSystem.Spacing.m)
    }
    
    // 关闭视图
    private func dismiss() {
        // 触发关闭回调
        onDismiss()
    }
    
    // 发送评论
    private func handleSendComment() {
        let trimmedText = commentText.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmedText.isEmpty else { return }
        
        // 触发评论回调
        onAddComment?(post, trimmedText, replyingTo?.id)
        
        // 触觉反馈 - 使用成功类型
        let feedback = UINotificationFeedbackGenerator()
        feedback.notificationOccurred(.success)
        
        // 清空输入
        commentText = ""
        // 重置回复状态
        replyingTo = nil
        // 关闭表情选择器
        showEmojiPicker = false
    }
    
    // 计算内容偏移量 - 用于滑动切换动画
    private func getContentOffset() -> CGFloat {
        return dragOffset.width
    }
    
    // 当前应显示的帖子 - 根据过渡状态决定显示内容
    private var currentDisplayPost: UserPostModel {
        // 默认显示当前帖子
        return post
    }
    
    // 评论栏透明度 - 根据状态决定是否显示
    private var commentBarOpacity: Double {
        // 全屏模式下，隐藏评论栏
        if isFullImmersiveMode {
            return 0
        }
        
        // 拖动时，也隐藏评论栏
        if abs(dragOffset.width) > 20 {
            return 0
        }
        
        // 默认显示
        return 1
    }
    
    // 内容透明度 - 用于切换动画
    private var contentOpacity: Double {
        // 在拖动切换时，根据拖动距离动态调整透明度
        if abs(dragOffset.width) > 0 {
            // 最多降低到0.7
            return max(1.0 - Double(abs(dragOffset.width)) / 500.0, 0.7)
        }
        return 1
    }
    
    // MARK: - 新增的安全区域处理方法
    
    /**
     * 递归禁用视图层级中的安全区域
     */
    private func disableSafeAreaInViewHierarchy(_ view: UIView) {
        // 特别处理ScrollView
        if let scrollView = view as? UIScrollView {
            scrollView.contentInsetAdjustmentBehavior = .never
            scrollView.automaticallyAdjustsScrollIndicatorInsets = false
            scrollView.contentInset = .zero
            scrollView.scrollIndicatorInsets = .zero
        }
        
        // 递归处理所有子视图
        for subview in view.subviews {
            disableSafeAreaInViewHierarchy(subview)
        }
        
        // 尝试使用运行时动态修改safeAreaInsets
        if let viewClass = object_getClass(view) {
            let selector = #selector(getter: UIView.safeAreaInsets)
            if class_getInstanceMethod(viewClass, selector) != nil {
                // 生成一个唯一的subclass名称
                let className = String(cString: class_getName(viewClass))
                let newClassName = className + "_NoSafeArea_" + UUID().uuidString
                
                // 创建子类
                if let newClass = objc_allocateClassPair(viewClass, newClassName, 0) {
                    // 替换safeAreaInsets方法
                    let method = class_getInstanceMethod(UIView.self, selector)!
                    let implementation = imp_implementationWithBlock({ (_: AnyObject) -> UIEdgeInsets in
                        return .zero
                    } as @convention(block) (AnyObject) -> UIEdgeInsets)
                    
                    class_addMethod(newClass, selector, implementation, method_getTypeEncoding(method))
                    objc_registerClassPair(newClass)
                    
                    // 设置view为新类型
                    object_setClass(view, newClass)
                }
            }
        }
    }
    
    // MARK: - 处理评论相关功能
    
    // 添加评论
    private func addComment(content: String, replyToID: UUID? = nil) {
        guard !content.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return }
        
        // 创建新评论
        _ = UserCommentModel(
            username: "当前用户", // 应替换为实际用户名
            userAvatar: "current_user_avatar", // 应替换为实际头像
            content: content,
            datePosted: Date(),
            likes: 0,
            isLikedByCurrentUser: false,
            isVirtualCharacter: false,
            characterID: nil
        )
        
        // 使用post的addComment方法创建新的post对象
        if let onAddCommentHandler = onAddComment {
            onAddCommentHandler(post, content, replyToID)
        }
        
        // 添加成功后给予触觉反馈
        let generator = UIImpactFeedbackGenerator(style: .medium)
        generator.impactOccurred()
    }
}

/**
 * 滚动偏移量首选项键
 */
struct ScrollOffsetPreferenceKey: PreferenceKey {
    static var defaultValue: CGFloat = 0
    static func reduce(value: inout CGFloat, nextValue: () -> CGFloat) {
        value = nextValue()
    }
}

/**
 * 水平滑动模态呈现修饰符
 * 用于替换默认的从下往上的模态呈现方式
 */
struct PostDetailHorizontalModalTransition: ViewModifier {
    let isPresented: Binding<Bool>
    let onDismiss: (() -> Void)?
    let content: () -> AnyView
    let direction: ModalDirection
    
    enum ModalDirection {
        case fromRight
        case fromLeft
    }
    
    @State private var internalIsPresented = false
    @State private var slideInPosition = CGSize.zero
    
    init<V: View>(isPresented: Binding<Bool>, direction: ModalDirection = .fromRight, onDismiss: (() -> Void)? = nil, @ViewBuilder content: @escaping () -> V) {
        self.isPresented = isPresented
        self.onDismiss = onDismiss
        self.content = { AnyView(content()) }
        self.direction = direction
    }
    
    func body(content: Content) -> some View {
        ZStack {
            content
                .onChange(of: isPresented.wrappedValue) { oldValue, newValue in
                    if newValue && !internalIsPresented {
                        // 根据方向从侧面滑入
                        let screenWidth = UIScreen.main.bounds.width
                        slideInPosition = CGSize(
                            width: direction == .fromRight ? screenWidth : -screenWidth, 
                            height: 0
                        )
                        withAnimation(.linear(duration: 0.01)) {
                            internalIsPresented = true
                        }
                        
                        // 在下一帧执行滑入动画
                        DispatchQueue.main.async {
                            withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
                                slideInPosition = .zero
                            }
                        }
                    } else if !newValue && internalIsPresented {
                        // 向侧面滑出
                        let screenWidth = UIScreen.main.bounds.width
                        withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
                            slideInPosition = CGSize(
                                width: direction == .fromRight ? screenWidth : -screenWidth, 
                                height: 0
                            )
                        }
                        
                        // 动画完成后关闭
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) {
                            internalIsPresented = false
                            onDismiss?()
                        }
                    }
                }
            
            if internalIsPresented {
                self.content()
                    .edgesIgnoringSafeArea(.all)
                    .offset(x: slideInPosition.width, y: 0)
                    .transition(.identity)
                    .zIndex(999)
            }
        }
    }
}

// 扩展 View 以添加自定义模态呈现修饰符
extension View {
    func postDetailHorizontalModal<Content: View>(
        isPresented: Binding<Bool>,
        direction: PostDetailHorizontalModalTransition.ModalDirection = .fromRight,
        onDismiss: (() -> Void)? = nil,
        @ViewBuilder content: @escaping () -> Content
    ) -> some View {
        modifier(PostDetailHorizontalModalTransition(isPresented: isPresented, direction: direction, onDismiss: onDismiss, content: content))
    }
}

