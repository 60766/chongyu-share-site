/**
 * 全屏内容视图 - 使用UIKit实现真正的全屏效果
 * 完全绕过SwiftUI的安全区域限制
 */
struct FullscreenContentView: UIViewControllerRepresentable {
    let post: UserPostModel
    @Binding var scrollOffset: CGFloat
    @Binding var scrollToCommentSection: Bool
    @Binding var dragOffset: CGSize
    let contentOpacity: Double
    let onLike: (UserCommentModel) -> Void
    let onReply: (UserCommentModel) -> Void
    let onTapGesture: () -> Void
    
    func makeUIViewController(context: Context) -> UIHostingController<FullscreenContent> {
        let hostingController = UIHostingController(
            rootView: FullscreenContent(
                post: post,
                scrollOffset: $scrollOffset,
                scrollToCommentSection: $scrollToCommentSection,
                dragOffset: $dragOffset,
                contentOpacity: contentOpacity,
                onLike: onLike,
                onReply: onReply,
                onTapGesture: onTapGesture
            )
        )
        
        // 关键设置：禁用安全区域调整
        hostingController.view.backgroundColor = .clear
        
        // 使用我们之前创建的扩展彻底禁用安全区域
        hostingController.disableSafeAreaEnhanced()
        
        // 额外的设置，确保内容延伸到边缘
        hostingController.additionalSafeAreaInsets = .zero

        // 设置 Home Indicator 自动隐藏 - 提高沉浸感
        hostingController.setupPrefersHomeIndicatorAutoHidden() // 首先设置子类化
        hostingController.enableHomeIndicatorAutoHiding() // 然后启用自动隐藏
        
        // 更新获取window的方式，兼容iOS 15+
        if #available(iOS 15.0, *) {
            // 使用UIWindowScene.windows
            if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
               let window = windowScene.windows.first {
                // 获取最底层的ViewController，确保它不受安全区域限制
                if var topController = window.rootViewController {
                    while let presentedViewController = topController.presentedViewController {
                        topController = presentedViewController
                    }
                    // 将禁用安全区域的设置应用到顶层控制器
                    topController.additionalSafeAreaInsets = .zero
                    topController.view.insetsLayoutMarginsFromSafeArea = false
                }
            }
        } else {
            // iOS 15以下使用旧API
            if let window = UIApplication.shared.windows.first {
                // 获取最底层的ViewController，确保它不受安全区域限制
                if var topController = window.rootViewController {
                    while let presentedViewController = topController.presentedViewController {
                        topController = presentedViewController
                    }
                    // 将禁用安全区域的设置应用到顶层控制器
                    topController.additionalSafeAreaInsets = .zero
                    topController.view.insetsLayoutMarginsFromSafeArea = false
                }
            }
        }
        
        return hostingController
    }
    
    func updateUIViewController(_ uiViewController: UIHostingController<FullscreenContent>, context: Context) {
        uiViewController.rootView = FullscreenContent(
            post: post,
            scrollOffset: $scrollOffset,
            scrollToCommentSection: $scrollToCommentSection,
            dragOffset: $dragOffset,
            contentOpacity: contentOpacity,
            onLike: onLike,
            onReply: onReply,
            onTapGesture: onTapGesture
        )
        
        // 确保每次更新都应用设置
        uiViewController.disableSafeAreaEnhanced()
    }
    
    // 内部内容视图 - 复用现有视图内容
    struct FullscreenContent: View {
        let post: UserPostModel
        @Binding var scrollOffset: CGFloat
        @Binding var scrollToCommentSection: Bool
        @Binding var dragOffset: CGSize
        let contentOpacity: Double
        let onLike: (UserCommentModel) -> Void
        let onReply: (UserCommentModel) -> Void
        let onTapGesture: () -> Void
        
        var body: some View {
            GeometryReader { geometry in
                ScrollViewReader { scrollProxy in
                    ScrollView {
                        // 滚动位置检测
                        scrollPositionDetector
                        
                        // 内容区
                        VStack(spacing: 0) {
                            // 帖子内容部分
                            makePostContentSection(for: post)
                                .id("postContent")
                            
                            // 分隔线
                            Rectangle()
                                .fill(Color(UIColor.systemGroupedBackground))
                                .frame(height: 8)
                            
                            // 评论区部分
                            makeCommentsSection(for: post)
                                .id("comments")
                                
                            // 彻底移除底部留白，确保内容能延伸到底部边缘
                            // 不再添加任何底部空间
                        }
                        .opacity(contentOpacity)
                        .offset(x: dragOffset.width)
                        .onTapGesture(count: 2) {
                            onTapGesture()
                        }
                    }
                    // 使用这些修饰符确保滚动视图真正全屏
                    .ignoresSafeArea(.all)
                    .edgesIgnoringSafeArea(.all)
                    .padding(.bottom, 0) // 确保没有底部内边距
                    .padding(.top, 0) // 确保没有顶部内边距
                    .background(Color.clear) // 使用透明背景代替白色
                    .coordinateSpace(name: "scrollView")
                    .onPreferenceChange(ScrollOffsetPreferenceKey.self) { offset in
                        withAnimation(.easeOut) {
                            scrollOffset = -offset
                        }
                    }
                    .onChange(of: scrollToCommentSection) { _, newValue in
                        if newValue {
                            withAnimation {
                                scrollProxy.scrollTo("comments", anchor: .top)
                            }
                            scrollToCommentSection = false
                        }
                    }
                }
            }
            // 确保所有边缘都被忽略
            .ignoresSafeArea(edges: .all)
        }
        
        // 滚动位置检测器
        private var scrollPositionDetector: some View {
            GeometryReader { innerGeometry in
                Color.clear.preference(
                    key: ScrollOffsetPreferenceKey.self,
                    value: innerGeometry.frame(in: .named("scrollView")).minY
                )
            }
            .frame(height: 0)
        }
        
        // 生成指定帖子的内容区域 (复用现有实现)
        private func makePostContentSection(for currentPost: UserPostModel) -> some View {
            VStack(alignment: .leading, spacing: DesignSystem.Spacing.l) {
                // 用户信息栏 - 提高视觉层级，增强区分度
                HStack(spacing: DesignSystem.Spacing.m) {
                    // 用户头像 - 增大尺寸增强存在感
                    Image(currentPost.userAvatar)
                        .resizable()
                        .aspectRatio(contentMode: .fill)
                        .frame(width: 48, height: 48)
                        .clipShape(Circle())
                        .overlay(Circle().stroke(DesignSystem.Colors.primary.opacity(0.2), lineWidth: 2))
                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                    
                    VStack(alignment: .leading, spacing: 4) {
                        // 用户名 - 增强视觉权重
                        Text(currentPost.username)
                            .font(DesignSystem.Typography.title3.weight(.semibold))
                            .foregroundColor(DesignSystem.Colors.primaryText)
                        
                        // 发布时间 - 增强对比度和识别性
                        HStack(spacing: 6) {
                            Text(currentPost.getFormattedTimeAgo())
                                .font(DesignSystem.Typography.footnote)
                                .foregroundColor(DesignSystem.Colors.secondaryText)
                                .padding(.vertical, 2)
                            
                            // 添加角色标签，增强身份识别
                            if currentPost.username == "历史探索者" {
                                Text("探索者")
                                    .font(DesignSystem.Typography.caption.weight(.medium))
                                    .padding(.horizontal, 6)
                                    .padding(.vertical, 2)
                                    .background(DesignSystem.Colors.primary.opacity(0.15))
                                    .foregroundColor(DesignSystem.Colors.primary)
                                    .cornerRadius(6)
                            }
                        }
                    }
                    
                    Spacer()
                    
                    // 关注按钮 - 更突出的视觉设计
                    Button(action: {
                        // 关注操作
                        let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                        feedbackGenerator.impactOccurred(intensity: 0.4)
                    }) {
                        Text("关注")
                            .font(DesignSystem.Typography.subheadline.weight(.medium))
                            .padding(.horizontal, DesignSystem.Spacing.m)
                            .padding(.vertical, 8)
                            .background(DesignSystem.Colors.primary)
                            .foregroundColor(.white)
                            .cornerRadius(18)
                            .shadow(color: DesignSystem.Colors.primary.opacity(0.3), radius: 2, x: 0, y: 1)
                    }
                    .buttonStyle(ScaleButtonStyle()) // 添加触摸反馈
                }
                .padding(.bottom, DesignSystem.Spacing.m)
                
                // 添加分隔线，增强视觉结构
                Divider()
                    .padding(.bottom, DesignSystem.Spacing.m)
                
                // 帖子内容文本 - 优化排版
                Group {
                    // 使用增强的文本排版，支持段落分隔
                    Text(enhanceTextLayout(currentPost.content))
                        .font(DesignSystem.Typography.body)
                        .lineSpacing(4) // 增加行距，提高可读性
                        .foregroundColor(DesignSystem.Colors.primaryText)
                        .fixedSize(horizontal: false, vertical: true) // 确保文本完全展开
                }
                .padding(.bottom, DesignSystem.Spacing.m)
                
                // 图片或视频展示区 - 优化布局和视觉效果
                if !currentPost.images.isEmpty {
                    VStack(spacing: DesignSystem.Spacing.s) {
                        // 图片画廊
                        if currentPost.images.count == 1 {
                            // 单张图片使用全宽显示
                            Image(currentPost.images[0])
                                .resizable()
                                .scaledToFill()
                                .frame(height: 240)
                                .clipped()
                                .cornerRadius(DesignSystem.Radius.l)
                                .shadow(color: Color.black.opacity(0.05), radius: 4, x: 0, y: 2)
                        } else {
                            // 多张图片使用网格布局
                            LazyVGrid(columns: [
                                GridItem(.flexible()), 
                                GridItem(.flexible())
                            ], spacing: 8) {
                                ForEach(currentPost.images, id: \.self) { image in
                                    Image(image)
                                        .resizable()
                                        .scaledToFill()
                                        .frame(height: 180)
                                        .clipped()
                                        .cornerRadius(DesignSystem.Radius.m)
                                        .shadow(color: Color.black.opacity(0.05), radius: 2, x: 0, y: 1)
                                }
                            }
                        }
                    }
                    .padding(.bottom, DesignSystem.Spacing.m)
                }
                
                // 添加主题相关信息
                if currentPost.content.contains("爱因斯坦") || currentPost.content.contains("相对论") {
                    HStack {
                        Image(systemName: "lightbulb.fill")
                            .foregroundColor(Color.yellow)
                        Text("相关主题：相对论、物理学")
                            .font(DesignSystem.Typography.caption)
                            .foregroundColor(DesignSystem.Colors.secondaryText)
                    }
                    .padding(.horizontal, DesignSystem.Spacing.s)
                    .padding(.vertical, 6)
                    .background(Color.yellow.opacity(0.1))
                    .cornerRadius(DesignSystem.Radius.m)
                    .padding(.bottom, DesignSystem.Spacing.m)
                }
                
                Divider()
                    .padding(.bottom, DesignSystem.Spacing.m)
                
                // 互动区域 - 优化交互元素布局和视觉反馈
                HStack(spacing: DesignSystem.Spacing.xl) {
                    // 点赞按钮
                    Button(action: {
                        // 点赞操作
                        let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                        feedbackGenerator.impactOccurred(intensity: 0.5)
                    }) {
                        HStack(spacing: DesignSystem.Spacing.xs) {
                            Image(systemName: currentPost.isLikedByCurrentUser ? "heart.fill" : "heart")
                                .font(.system(size: 18))
                                .foregroundColor(currentPost.isLikedByCurrentUser ? .red : DesignSystem.Colors.secondaryText)
                            
                            Text("\(currentPost.likes)")
                                .font(DesignSystem.Typography.subheadline)
                                .foregroundColor(currentPost.isLikedByCurrentUser ? .red : DesignSystem.Colors.secondaryText)
                        }
                        .padding(.vertical, 8)
                        .padding(.horizontal, 12)
                        .background(Color.gray.opacity(0.1))
                        .cornerRadius(20)
                    }
                    .buttonStyle(ScaleButtonStyle())
                    
                    // 评论按钮
                    Button(action: {
                        // 滚动到评论区
                        scrollToCommentSection = true
                        let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                        feedbackGenerator.impactOccurred(intensity: 0.5)
                    }) {
                        HStack(spacing: DesignSystem.Spacing.xs) {
                            Image(systemName: "text.bubble")
                                .font(.system(size: 18))
                                .foregroundColor(DesignSystem.Colors.secondaryText)
                            
                            Text("\(currentPost.comments.count)")
                                .font(DesignSystem.Typography.subheadline)
                                .foregroundColor(DesignSystem.Colors.secondaryText)
                        }
                        .padding(.vertical, 8)
                        .padding(.horizontal, 12)
                        .background(Color.gray.opacity(0.1))
                        .cornerRadius(20)
                    }
                    .buttonStyle(ScaleButtonStyle())
                    
                    // 收藏按钮
                    Button(action: {
                        // 收藏操作
                        let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                        feedbackGenerator.impactOccurred(intensity: 0.5)
                    }) {
                        Image(systemName: currentPost.isBookmarkedByCurrentUser ? "bookmark.fill" : "bookmark")
                            .font(.system(size: 18))
                            .foregroundColor(currentPost.isBookmarkedByCurrentUser ? DesignSystem.Colors.primary : DesignSystem.Colors.secondaryText)
                            .padding(.vertical, 8)
                            .padding(.horizontal, 12)
                            .background(Color.gray.opacity(0.1))
                            .cornerRadius(20)
                    }
                    .buttonStyle(ScaleButtonStyle())
                    
                    Spacer()
                    
                    // 分享按钮
                    Button(action: {
                        // 显示分享菜单
                        // 使用局部行为处理分享，不使用全局变量
                        let actionSheet = UIActivityViewController(
                            activityItems: ["分享这个帖子"], 
                            applicationActivities: nil
                        )
                        
                        // 在这里处理UIKit的分享表单
                        if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
                           let window = windowScene.windows.first,
                           let rootVC = window.rootViewController {
                            rootVC.present(actionSheet, animated: true)
                        }
                        
                        // 使用局部变量处理触觉反馈
                        let localFeedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                        localFeedbackGenerator.impactOccurred(intensity: 0.5)
                    }) {
                        Image(systemName: "square.and.arrow.up")
                            .font(.system(size: 18))
                            .foregroundColor(DesignSystem.Colors.secondaryText)
                            .padding(.vertical, 8)
                            .padding(.horizontal, 12)
                            .background(Color.gray.opacity(0.1))
                            .cornerRadius(20)
                    }
                    .buttonStyle(ScaleButtonStyle())
                }
            }
            .padding(DesignSystem.Spacing.l)
            .background(
                RoundedRectangle(cornerRadius: DesignSystem.Radius.xl)
                    .fill(DesignSystem.Colors.cardBackground)
                    .shadow(color: Color.black.opacity(0.05), radius: 2, x: 0, y: 1)
            )
        }
        
        // 优化文本布局的辅助方法
        private func enhanceTextLayout(_ text: String) -> String {
            // 添加适当的段落分隔，增强可读性
            // 实际应用中这里可以处理换行、段落等格式化
            return text
        }
        
        // 生成指定帖子的评论区域 (复用现有实现)
        private func makeCommentsSection(for currentPost: UserPostModel) -> some View {
            // 评论区标题和内容
            VStack(alignment: .leading, spacing: 0) {
                // 评论区标题 - 增强视觉层次和信息区分
                HStack(spacing: DesignSystem.Spacing.s) {
                    Image(systemName: "text.bubble.fill")
                        .foregroundColor(DesignSystem.Colors.primary)
                        .font(.system(size: 20))
                    
                    Text("全部评论")
                        .font(DesignSystem.Typography.title3.weight(.semibold))
                        .foregroundColor(DesignSystem.Colors.primaryText)
                    
                    Text("(\(currentPost.comments.count))")
                        .font(DesignSystem.Typography.title3)
                        .padding(.horizontal, 8)
                        .padding(.vertical, 2)
                        .background(DesignSystem.Colors.primary.opacity(0.1))
                        .foregroundColor(DesignSystem.Colors.primary)
                        .cornerRadius(12)
                    
                    Spacer()
                    
                    // 添加排序选项按钮
                    Menu {
                        Button(action: {
                            // 按最新排序
                        }) {
                            Label("最新", systemImage: "arrow.up")
                        }
                        
                        Button(action: {
                            // 按热度排序
                        }) {
                            Label("热度", systemImage: "flame")
                        }
                    } label: {
                        HStack(spacing: 4) {
                            Text("最新")
                                .font(DesignSystem.Typography.subheadline)
                            Image(systemName: "chevron.down")
                                .font(.system(size: 12))
                        }
                        .foregroundColor(DesignSystem.Colors.secondaryText)
                        .padding(.horizontal, 10)
                        .padding(.vertical, 6)
                        .background(Color.gray.opacity(0.1))
                        .cornerRadius(16)
                    }
                }
                .padding(.horizontal, DesignSystem.Spacing.l)
                .padding(.vertical, DesignSystem.Spacing.m)
                
                // 分隔线
                Divider()
                    .padding(.horizontal, DesignSystem.Spacing.l)
                
                if currentPost.comments.isEmpty {
                    // 空评论状态 - 更吸引人的空状态设计
                    VStack(spacing: DesignSystem.Spacing.l) {
                        Image(systemName: "bubble.left.and.text.bubble.right")
                            .font(.system(size: 40))
                            .foregroundColor(Color.gray.opacity(0.3))
                            .padding()
                            .background(Color.gray.opacity(0.05))
                            .clipShape(Circle())
                        
                        VStack(spacing: DesignSystem.Spacing.s) {
                            Text("还没有评论")
                                .font(DesignSystem.Typography.title3)
                                .foregroundColor(DesignSystem.Colors.primaryText)
                            
                            Text("快来发表第一条评论吧!")
                                .font(DesignSystem.Typography.body)
                                .foregroundColor(DesignSystem.Colors.secondaryText)
                        }
                        
                        Button(action: {
                            // 聚焦到评论输入框
                            let localFeedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                            localFeedbackGenerator.impactOccurred(intensity: 0.5)
                            // 触发评论输入框聚焦
                            NotificationCenter.default.post(
                                name: Notification.Name("FocusCommentInput"),
                                object: nil
                            )
                        }) {
                            Text("发表评论")
                                .font(DesignSystem.Typography.body.weight(.medium))
                                .padding(.horizontal, 24)
                                .padding(.vertical, 12)
                                .background(DesignSystem.Colors.primary)
                                .foregroundColor(.white)
                                .cornerRadius(24)
                                .shadow(color: DesignSystem.Colors.primary.opacity(0.3), radius: 3, x: 0, y: 2)
                        }
                        .buttonStyle(ScaleButtonStyle())
                    }
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 60)
                } else {
                    // 评论列表 - 使用顶级的增强评论列表视图
                    EnhancedCommentsListView(
                        comments: currentPost.comments,
                        onReply: { comment in
                        // 触发评论回复回调
                        replyingTo = comment
                        // 从全屏模式切换回普通模式以显示评论输入框
                        if isFullImmersiveMode {
                            isFullImmersiveMode = false
                        }
                        // 触觉反馈
                        let generator = UIImpactFeedbackGenerator(style: .medium)
                        generator.impactOccurred(intensity: 0.4)
                    },
                        onLike: { comment in
                        // 触发点赞回调
                        onLikeComment?(post, comment)
                        // 触觉反馈
                        let generator = UIImpactFeedbackGenerator(style: .medium)
                        generator.impactOccurred(intensity: 0.4)
                    }
                    )
                    .padding(.horizontal, DesignSystem.Spacing.m)
                }
            }
            .background(
                RoundedRectangle(cornerRadius: DesignSystem.Radius.xl)
                    .fill(DesignSystem.Colors.cardBackground)
                    .shadow(color: Color.black.opacity(0.05), radius: 2, x: 0, y: 1)
            )
            .padding(.top, DesignSystem.Spacing.m)
        }
        
        // 格式化时间的辅助方法
        private func getFormattedTimeAgo(from date: Date) -> String {
            let formatter = RelativeDateTimeFormatter()
            formatter.unitsStyle = .short
            return formatter.localizedString(for: date, relativeTo: Date())
        }
    }
}

/**
 * 增强评论列表视图
 * 提供更美观的评论列表显示效果
 */
struct EnhancedCommentsListView: View {
    let comments: [UserCommentModel]
    let onReply: (UserCommentModel) -> Void
    let onLike: (UserCommentModel) -> Void
    
    var body: some View {
        LazyVStack(alignment: .leading, spacing: DesignSystem.Spacing.m) {
            ForEach(comments) { comment in
                CommentCell(
                    comment: comment,
                    onReply: { onReply(comment) },
                    onLike: { onLike(comment) }
                )
                
                if comments.last?.id != comment.id {
                    Divider()
                        .padding(.vertical, 4)
                }
            }
        }
    }
}

/**
 * 评论单元格
 * 显示单条评论的视图
 */
private struct CommentCell: View {
    let comment: UserCommentModel
    let onReply: () -> Void
    let onLike: () -> Void
    @State private var showOptions: Bool = false
    
    var body: some View {
        VStack(alignment: .leading, spacing: DesignSystem.Spacing.s) {
            // 用户信息和评论内容
            HStack(alignment: .top, spacing: DesignSystem.Spacing.m) {
                // 用户头像
                Image(comment.userAvatar)
                    .resizable()
                    .aspectRatio(contentMode: .fill)
                    .frame(width: 40, height: 40)
                    .clipShape(Circle())
                    .overlay(
                        Circle()
                            .stroke(
                                comment.isVirtualCharacter ? 
                                    DesignSystem.Colors.primary.opacity(0.3) : 
                                    Color.gray.opacity(0.1), 
                                lineWidth: 2
                            )
                    )
                
                VStack(alignment: .leading, spacing: 6) {
                    // 用户名和标签
                    HStack(spacing: 6) {
                        Text(comment.username)
                            .font(DesignSystem.Typography.title3.weight(.medium))
                            .foregroundColor(DesignSystem.Colors.primaryText)
                        
                        // 用户类型标签 - 区分不同类型的评论者
                        if comment.isVirtualCharacter {
                            Text("历史人物")
                                .font(DesignSystem.Typography.caption.weight(.medium))
                                .padding(.horizontal, 6)
                                .padding(.vertical, 2)
                                .background(DesignSystem.Colors.primary.opacity(0.15))
                                .foregroundColor(DesignSystem.Colors.primary)
                                .cornerRadius(6)
                        }
                        
                        Spacer()
                        
                        // 评论时间 - 增强可读性
                        Text(getTimeAgo(from: comment.datePosted))
                            .font(DesignSystem.Typography.caption)
                            .foregroundColor(DesignSystem.Colors.tertiaryText)
                    }
                    
                    // 评论内容 - 增加行距提高可读性
                    Text(comment.content)
                        .font(DesignSystem.Typography.body)
                        .lineSpacing(2)
                        .foregroundColor(DesignSystem.Colors.primaryText)
                    
                    // 评论操作按钮
                    HStack(spacing: DesignSystem.Spacing.l) {
                        // 点赞按钮
                        Button(action: onLike) {
                            HStack(spacing: 4) {
                                Image(systemName: comment.isLikedByCurrentUser ? "heart.fill" : "heart")
                                    .font(.system(size: 14))
                                Text("\(comment.likes)")
                                    .font(DesignSystem.Typography.footnote)
                            }
                            .foregroundColor(comment.isLikedByCurrentUser ? .red : DesignSystem.Colors.secondaryText)
                        }
                        
                        // 回复按钮
                        Button(action: onReply) {
                            HStack(spacing: 4) {
                                Image(systemName: "arrowshape.turn.up.left")
                                    .font(.system(size: 14))
                                Text("回复")
                                    .font(DesignSystem.Typography.footnote)
                            }
                            .foregroundColor(DesignSystem.Colors.secondaryText)
                        }
                        
                        // 更多操作按钮
                        Button(action: { showOptions = true }) {
                            Image(systemName: "ellipsis")
                                .font(.system(size: 14))
                                .foregroundColor(DesignSystem.Colors.secondaryText)
                        }
                        .actionSheet(isPresented: $showOptions) {
                            ActionSheet(
                                title: Text("评论操作"),
                                buttons: [
                                    .default(Text("复制评论")) { /* 复制操作 */ },
                                    .default(Text("举报")) { /* 举报操作 */ },
                                    .cancel(Text("取消"))
                                ]
                            )
                        }
                    }
                    .padding(.top, 4)
                }
            }
        }
        .padding(.horizontal, DesignSystem.Spacing.s)
        .padding(.vertical, DesignSystem.Spacing.s)
        .contentShape(Rectangle())
        .animation(.easeOut(duration: 0.2), value: showOptions)
    }
    
    // 格式化时间的辅助方法
    private func getTimeAgo(from date: Date) -> String {
        let formatter = RelativeDateTimeFormatter()
        formatter.unitsStyle = .short
        return formatter.localizedString(for: date, relativeTo: Date())
    }
} 