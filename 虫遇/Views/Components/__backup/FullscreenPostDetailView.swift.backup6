/**
 * 全屏内容视图 - 使用UIKit实现真正的全屏效果
 * 完全绕过SwiftUI的安全区域限制
 */
struct FullscreenContentView: UIViewControllerRepresentable {
    let post: UserPostModel
    @Binding var scrollOffset: CGFloat
    @Binding var scrollToCommentSection: Bool
    @Binding var dragOffset: CGSize
    let contentOpacity: Double
    let onLike: (UserCommentModel) -> Void
    let onReply: (UserCommentModel) -> Void
    let onTapGesture: () -> Void
    
    // 添加isFullImmersiveMode绑定变量
    @Binding var isFullImmersiveMode: Bool
    
    // 添加replyingTo绑定属性
    @Binding var replyingTo: UserCommentModel?
    
    func makeUIViewController(context: Context) -> UIHostingController<FullscreenContent> {
        let hostingController = UIHostingController(
            rootView: FullscreenContent(
                post: post,
                scrollOffset: $scrollOffset,
                scrollToCommentSection: $scrollToCommentSection,
                dragOffset: $dragOffset,
                contentOpacity: contentOpacity,
                onLike: { comment in
                    self.onLike(comment)
                },
                onReply: { comment in
                    self.onReply(comment)
                },
                onTapGesture: onTapGesture,
                isFullImmersiveMode: $isFullImmersiveMode,
                replyingTo: $replyingTo
            )
        )
        
        // 关键设置：禁用安全区域调整
        hostingController.view.backgroundColor = .clear
        
        // 使用我们之前创建的扩展彻底禁用安全区域
        hostingController.disableSafeAreaEnhanced()
        
        // 额外的设置，确保内容延伸到边缘
        hostingController.additionalSafeAreaInsets = .zero

        // 设置 Home Indicator 自动隐藏 - 提高沉浸感
        hostingController.setupPrefersHomeIndicatorAutoHidden() // 首先设置子类化
        hostingController.enableHomeIndicatorAutoHiding() // 然后启用自动隐藏
        
        // 更新获取window的方式，兼容iOS 15+
        if #available(iOS 15.0, *) {
            // 使用UIWindowScene.windows
            if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
               let window = windowScene.windows.first {
                // 获取最底层的ViewController，确保它不受安全区域限制
                if var topController = window.rootViewController {
                    while let presentedViewController = topController.presentedViewController {
                        topController = presentedViewController
                    }
                    // 将禁用安全区域的设置应用到顶层控制器
                    topController.additionalSafeAreaInsets = .zero
                    topController.view.insetsLayoutMarginsFromSafeArea = false
                }
            }
        } else {
            // iOS 15以下使用旧API
            if let window = UIApplication.shared.windows.first {
                // 获取最底层的ViewController，确保它不受安全区域限制
                if var topController = window.rootViewController {
                    while let presentedViewController = topController.presentedViewController {
                        topController = presentedViewController
                    }
                    // 将禁用安全区域的设置应用到顶层控制器
                    topController.additionalSafeAreaInsets = .zero
                    topController.view.insetsLayoutMarginsFromSafeArea = false
                }
            }
        }
        
        return hostingController
    }
    
    func updateUIViewController(_ uiViewController: UIHostingController<FullscreenContent>, context: Context) {
        uiViewController.rootView = FullscreenContent(
            post: post,
            scrollOffset: $scrollOffset,
            scrollToCommentSection: $scrollToCommentSection,
            dragOffset: $dragOffset,
            contentOpacity: contentOpacity,
            onLike: { comment in
                self.onLike(comment)
            },
            onReply: { comment in
                self.onReply(comment)
            },
            onTapGesture: onTapGesture,
            isFullImmersiveMode: $isFullImmersiveMode,
            replyingTo: $replyingTo
        )
        
        // 确保每次更新都应用设置
        uiViewController.disableSafeAreaEnhanced()
    }
    
    // 内部内容视图 - 复用现有视图内容
    struct FullscreenContent: View {
        let post: UserPostModel
        @Binding var scrollOffset: CGFloat
        @Binding var scrollToCommentSection: Bool
        @Binding var dragOffset: CGSize
        let contentOpacity: Double
        let onLike: ((UserCommentModel) -> Void)?
        let onReply: ((UserCommentModel) -> Void)?
        let onTapGesture: () -> Void
        
        // 添加isFullImmersiveMode绑定变量
        @Binding var isFullImmersiveMode: Bool
        
        // 添加replyingTo绑定属性
        @Binding var replyingTo: UserCommentModel?
        
        // 添加likedComments状态变量
        @State private var likedComments: Set<UUID> = []
        
        // 获取设备颜色模式
        @Environment(\.colorScheme) var colorScheme
        
        var body: some View {
            GeometryReader { geometry in
                ScrollViewReader { scrollProxy in
                    ScrollView {
                        // 滚动位置检测
                        scrollPositionDetector
                        
                        // 内容区
                        VStack(spacing: 0) {
                            // 帖子内容部分
                            makePostContentSection(for: post)
                                .id("postContent")
                            
                            // 移除灰色分隔线，使用透明间隔代替
                            Color.clear
                                .frame(height: 1)
                            
                            // 评论区部分
                            makeCommentsSection(for: post)
                                .id("comments")
                                
                            // 额外添加一个超小的填充区域，以确保ScrollView完全滚动到底部
                            Color.clear
                                .frame(height: 1)
                                
                            // 添加柔和的分隔线
                            Rectangle()
                                .fill(Color(UIColor.separator).opacity(0.2))
                                .frame(height: 0.5)
                        }
                        .opacity(contentOpacity)
                        .offset(x: dragOffset.width)
                        .onTapGesture(count: 2) {
                            onTapGesture()
                        }
                    }
                    // 使用这些修饰符确保滚动视图真正全屏
                    .ignoresSafeArea(.all)
                    .edgesIgnoringSafeArea(.all)
                    .padding(.bottom, 0) // 确保没有底部内边距
                    .padding(.top, 0) // 确保没有顶部内边距
                    .background(Color.clear) // 使用透明背景代替白色
                    .coordinateSpace(name: "scrollView")
                    .onPreferenceChange(ScrollOffsetPreferenceKey.self) { offset in
                        withAnimation(.easeOut) {
                            scrollOffset = -offset
                        }
                    }
                    .onChange(of: scrollToCommentSection) { _, newValue in
                        if newValue {
                            withAnimation {
                                scrollProxy.scrollTo("comments", anchor: .top)
                            }
                            scrollToCommentSection = false
                        }
                    }
                }
            }
            // 确保所有边缘都被忽略
            .ignoresSafeArea(edges: .all)
        }
        
        // 滚动位置检测器
        private var scrollPositionDetector: some View {
            GeometryReader { innerGeometry in
                Color.clear.preference(
                    key: ScrollOffsetPreferenceKey.self,
                    value: innerGeometry.frame(in: .named("scrollView")).minY
                )
            }
            .frame(height: 0)
        }
        
        // 生成指定帖子的内容区域 (复用现有实现)
        private func makePostContentSection(for currentPost: UserPostModel) -> some View {
            VStack(alignment: .leading, spacing: DesignSystem.Spacing.s) {
                // 用户信息区域 - 极简设计
                HStack(spacing: DesignSystem.Spacing.m) {
                    // 头像 - 简洁设计
                    Image(currentPost.userAvatar)
                        .resizable()
                        .aspectRatio(contentMode: .fill)
                        .frame(width: 38, height: 38)
                        .clipShape(Circle())
                    
                    // 用户名和时间
                    VStack(alignment: .leading, spacing: 2) {
                        Text(currentPost.username)
                            .font(.system(size: 15, weight: .medium))
                        
                        Text(currentPost.getFormattedTimeAgo())
                            .font(.system(size: 12))
                            .foregroundColor(.secondary)
                    }
                    
                    Spacer()
                    
                    // 简化的关注按钮
                    Button(action: {
                        let feedbackGenerator = UIImpactFeedbackGenerator(style: .light)
                        feedbackGenerator.impactOccurred(intensity: 0.5)
                    }) {
                        Text("关注")
                            .font(.system(size: 13, weight: .medium))
                            .foregroundColor(DesignSystem.Colors.primary)
                            .padding(.horizontal, 12)
                            .padding(.vertical, 4)
                            .background(
                                Capsule()
                                    .stroke(DesignSystem.Colors.primary, lineWidth: 1)
                            )
                    }
                    .buttonStyle(ScaleButtonStyle())
                }
                .padding(.horizontal, 16)
                .padding(.top, 12)
                .padding(.bottom, 8)
                
                // 正文内容 - 使用更宽松的间距
                Text(currentPost.content)
                    .font(.system(size: 16))
                    .lineSpacing(5)
                    .fixedSize(horizontal: false, vertical: true)
                    .padding(.horizontal, 16)
                    .padding(.bottom, 12)
                
                // 图片内容 - 简化布局
                if !currentPost.images.isEmpty {
                    if currentPost.images.count == 1 {
                        // 单图显示
                        Image(currentPost.images[0])
                            .resizable()
                            .scaledToFill()
                            .frame(maxHeight: 240)
                            .clipShape(RoundedRectangle(cornerRadius: 8))
                            .padding(.horizontal, 16)
                    } else {
                        // 多图网格 - 简化视觉效果
                        LazyVGrid(columns: [GridItem(.flexible()), GridItem(.flexible())], spacing: 8) {
                            ForEach(currentPost.images, id: \.self) { image in
                                Image(image)
                                    .resizable()
                                    .scaledToFill()
                                    .frame(height: 160)
                                    .clipShape(RoundedRectangle(cornerRadius: 8))
                            }
                        }
                        .padding(.horizontal, 16)
                    }
                    .padding(.bottom, 12)
                }
                
                // 互动按钮区 - 极简风格
                HStack(spacing: 24) {
                    // 点赞按钮
                    Button(action: {
                        let generator = UIImpactFeedbackGenerator(style: .light)
                        generator.impactOccurred(intensity: 0.5)
                    }) {
                        Label(
                            "\(currentPost.likes)",
                            systemImage: currentPost.isLikedByCurrentUser ? "heart.fill" : "heart"
                        )
                        .font(.system(size: 14))
                        .foregroundColor(currentPost.isLikedByCurrentUser ? .red : .secondary)
                    }
                    
                    // 评论按钮
                    Button(action: {
                        let generator = UIImpactFeedbackGenerator(style: .light)
                        generator.impactOccurred(intensity: 0.5)
                        scrollToCommentSection = true
                    }) {
                        Label(
                            "\(currentPost.comments.count)",
                            systemImage: "bubble.left"
                        )
                        .font(.system(size: 14))
                        .foregroundColor(.secondary)
                    }
                    
                    // 收藏按钮
                    Button(action: {
                        let generator = UIImpactFeedbackGenerator(style: .light)
                        generator.impactOccurred(intensity: 0.5)
                    }) {
                        Image(systemName: currentPost.isBookmarkedByCurrentUser ? "bookmark.fill" : "bookmark")
                            .font(.system(size: 14))
                            .foregroundColor(currentPost.isBookmarkedByCurrentUser ? DesignSystem.Colors.primary : .secondary)
                    }
                    
                    Spacer()
                    
                    // 分享按钮
                    Button(action: {
                        let generator = UIImpactFeedbackGenerator(style: .light)
                        generator.impactOccurred(intensity: 0.5)
                        showShareSheet = true
                    }) {
                        Image(systemName: "square.and.arrow.up")
                            .font(.system(size: 14))
                            .foregroundColor(.secondary)
                    }
                }
                .padding(.horizontal, 16)
                .padding(.bottom, 16)
                
                // 简单的分隔线
                Divider()
                    .padding(.horizontal, 16)
            }
            .background(Color(UIColor.systemBackground))
        }
        
        // 生成指定帖子的评论区域 (复用现有实现)
        private func makeCommentsSection(for currentPost: UserPostModel) -> some View {
            VStack(alignment: .leading, spacing: 0) {
                // 评论区标题
                HStack {
                    Text("评论")
                        .font(.system(size: 16, weight: .medium))
                    
                    Text("(\(currentPost.comments.count))")
                        .font(.system(size: 14))
                        .foregroundColor(.secondary)
                    
                    Spacer()
                    
                    // 排序按钮 - 简化为单个按钮
                    Button(action: {}) {
                        HStack(spacing: 4) {
                            Text("最新")
                                .font(.system(size: 14))
                            Image(systemName: "chevron.down")
                                .font(.system(size: 12))
                        }
                        .foregroundColor(.secondary)
                    }
                }
                .padding(.horizontal, 16)
                .padding(.vertical, 12)
                
                // 评论列表
                if currentPost.comments.isEmpty {
                    // 无评论状态
                    VStack(spacing: 8) {
                        Image(systemName: "bubble.left")
                            .font(.system(size: 24))
                            .foregroundColor(.secondary.opacity(0.5))
                            .padding(.bottom, 4)
                        
                        Text("暂无评论")
                            .font(.system(size: 15))
                            .foregroundColor(.secondary)
                        
                        Text("成为第一个评论的人吧")
                            .font(.system(size: 13))
                            .foregroundColor(.secondary.opacity(0.7))
                    }
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 30)
                } else {
                    // 有评论时显示列表 - 扁平简洁风格
                    ForEach(currentPost.comments) { comment in
                        VStack(alignment: .leading, spacing: 0) {
                            HStack(alignment: .top, spacing: 12) {
                                // 用户头像
                                Image(comment.userAvatar)
                                    .resizable()
                                    .aspectRatio(contentMode: .fill)
                                    .frame(width: 36, height: 36)
                                    .clipShape(Circle())
                                
                                VStack(alignment: .leading, spacing: 4) {
                                    // 用户信息
                                    HStack(alignment: .center, spacing: 6) {
                                        Text(comment.username)
                                            .font(.system(size: 14, weight: .medium))
                                        
                                        // 虚拟角色标识
                                        if comment.isVirtualCharacter {
                                            Text("历史人物")
                                                .font(.system(size: 10))
                                                .padding(.horizontal, 6)
                                                .padding(.vertical, 2)
                                                .background(DesignSystem.Colors.primary.opacity(0.1))
                                                .foregroundColor(DesignSystem.Colors.primary)
                                                .clipShape(Capsule())
                                        }
                                        
                                        Spacer()
                                        
                                        // 评论时间
                                        Text(getFormattedDate(from: comment.datePosted))
                                            .font(.system(size: 12))
                                            .foregroundColor(.secondary)
                                    }
                                    
                                    // 评论内容
                                    Text(comment.content)
                                        .font(.system(size: 15))
                                        .lineSpacing(4)
                                        .padding(.vertical, 4)
                                    
                                    // 评论互动按钮
                                    HStack(spacing: 16) {
                                        // 点赞按钮
                                        Button(action: {
                                            onLike?(comment)
                                        }) {
                                            Label(
                                                "\(comment.likes)",
                                                systemImage: likedComments.contains(comment.id) ? "heart.fill" : "heart"
                                            )
                                            .font(.system(size: 12))
                                            .foregroundColor(likedComments.contains(comment.id) ? .red : .secondary)
                                        }
                                        
                                        // 回复按钮
                                        Button(action: {
                                            self.replyingTo = comment
                                        }) {
                                            Text("回复")
                                                .font(.system(size: 12))
                                                .foregroundColor(.secondary)
                                        }
                                    }
                                }
                            }
                            .padding(.horizontal, 16)
                            .padding(.vertical, 12)
                            
                            Divider()
                                .padding(.leading, 64)
                        }
                    }
                }
            }
            .background(Color(UIColor.systemBackground))
        }
        
        // 格式化时间的辅助方法
        private func getFormattedDate(from date: Date) -> String {
            let formatter = RelativeDateTimeFormatter()
            formatter.unitsStyle = .short
            return formatter.localizedString(for: date, relativeTo: Date())
        }
    }
}

/**
 * 增强评论列表视图
 * 提供更美观的评论列表显示效果
 */
struct EnhancedCommentsListView: View {
    let comments: [UserCommentModel]
    let onReply: ((UserCommentModel) -> Void)?
    let onLike: ((UserCommentModel) -> Void)?
    let likedComments: Set<UUID>
    
    // 将评论分为历史人物评论和用户评论
    private var historicalComments: [UserCommentModel] {
        return comments.filter { $0.isVirtualCharacter }
    }
    
    private var userComments: [UserCommentModel] {
        return comments.filter { !$0.isVirtualCharacter }
    }
    
    var body: some View {
        LazyVStack(alignment: .leading, spacing: 0) {
            // 评论区标题
                HStack {
                Text("评论")
                    .font(.system(size: 16, weight: .semibold))
                    .foregroundColor(.primary)
                
                Text("(\(comments.count))")
                    .font(.system(size: 14))
                    .foregroundColor(.secondary)
                    
                    Spacer()
                
                // 排序选项
                Menu {
                    Button(action: {}) {
                        Label("最新", systemImage: "arrow.up")
                    }
                    Button(action: {}) {
                        Label("热度", systemImage: "flame")
                    }
                } label: {
                    HStack(spacing: 4) {
                        Text("最新")
                            .font(.system(size: 14))
                        Image(systemName: "chevron.down")
                            .font(.system(size: 12))
                    }
                    .foregroundColor(.secondary)
                }
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 12)
            
            // 历史人物评论区 - 如果有历史人物评论则显示
            if !historicalComments.isEmpty {
                HistoricalCommentsBlock(
                    comments: historicalComments,
                    onReply: onReply,
                    onLike: onLike,
                    likedComments: likedComments
                )
                
                Divider()
                    .padding(.vertical, 8)
            }
            
            // 用户评论区
            if userComments.isEmpty && historicalComments.isEmpty {
                // 完全没有评论时显示空状态
                EmptyCommentsView()
            } else if !userComments.isEmpty {
                UserCommentsBlock(
                    comments: userComments,
                    onReply: onReply,
                    onLike: onLike,
                    likedComments: likedComments
                )
            }
        }
        // 移除底部的内边距，确保没有额外空间
        .padding(.bottom, 0)
    }
}

/**
 * 历史人物评论区块
 * 显示历史人物评论，带有特殊样式
 */
private struct HistoricalCommentsBlock: View {
    let comments: [UserCommentModel]
    let onReply: ((UserCommentModel) -> Void)?
    let onLike: ((UserCommentModel) -> Void)?
    let likedComments: Set<UUID>
    
    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            // 历史人物标题
            HStack(spacing: 8) {
                Image(systemName: "sparkles")
                    .font(.system(size: 14))
                    .foregroundColor(DesignSystem.Colors.primary)
                
                Text("历史人物见解")
                    .font(.system(size: 15, weight: .medium))
                    .foregroundColor(.primary)
                
                if comments.count > 1 {
                    Text("(\(comments.count))")
                        .font(.system(size: 13))
                        .foregroundColor(.secondary)
                }
                
                Spacer()
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 8)
            .background(DesignSystem.Colors.primary.opacity(0.03))
            
            // 历史人物评论列表
            ForEach(comments) { comment in
                HistoricalCommentCell(
                    comment: comment,
                    onReply: { 
                        if let replyAction = onReply {
                            replyAction(comment)
                        }
                    },
                    onLike: { 
                        if let likeAction = onLike {
                            likeAction(comment)
                        }
                    },
                    isLiked: likedComments.contains(comment.id)
                )
                
                if comment.id != comments.last?.id {
                    Divider()
                        .padding(.vertical, 2)
                        .padding(.leading, 56)
                        .padding(.trailing, 16)
                }
            }
        }
    }
}

/**
 * 用户评论区块
 * 显示普通用户评论
 */
private struct UserCommentsBlock: View {
    let comments: [UserCommentModel]
    let onReply: ((UserCommentModel) -> Void)?
    let onLike: ((UserCommentModel) -> Void)?
    let likedComments: Set<UUID>
    
    // 分组评论 - 处理回复关系
    private var groupedComments: [(parent: UserCommentModel, replies: [UserCommentModel])] {
        // 这里模拟回复关系，实际项目中需要根据实际数据模型调整
        // 简单实现：每第三条评论为前一条的回复
        var result: [(parent: UserCommentModel, replies: [UserCommentModel])] = []
        var current: [UserCommentModel] = []
        
        for (index, comment) in comments.enumerated() {
            if index % 3 == 0 {
                // 作为主评论
                if !current.isEmpty {
                    if current.count > 1 {
                        result.append((parent: current[0], replies: Array(current[1...])))
                } else {
                        result.append((parent: current[0], replies: []))
                    }
                    current = []
                }
                current.append(comment)
            } else {
                // 作为回复
                current.append(comment)
            }
        }
        
        // 处理最后一组
        if !current.isEmpty {
            if current.count > 1 {
                result.append((parent: current[0], replies: Array(current[1...])))
            } else {
                result.append((parent: current[0], replies: []))
            }
        }
        
        return result
    }
    
    var body: some View {
        VStack(spacing: 0) {
            ForEach(groupedComments, id: \.parent.id) { group in
                VStack(alignment: .leading, spacing: 0) {
                    // 主评论
                    CommentCell(
                        comment: group.parent,
                        onReply: { 
                            if let replyAction = onReply {
                                replyAction(group.parent)
                            }
                        },
                        onLike: { 
                            if let likeAction = onLike {
                                likeAction(group.parent)
                            }
                        },
                        isLiked: likedComments.contains(group.parent.id)
                    )
                    
                    // 回复评论
                    if !group.replies.isEmpty {
                        ForEach(group.replies) { reply in
                            Divider()
                                .padding(.vertical, 1)
                                .padding(.leading, 56)
                                .padding(.trailing, 16)
                            
                            ReplyCommentCell(
                                comment: reply,
                                replyToUsername: group.parent.username,
                                onReply: { 
                                    if let replyAction = onReply {
                                        replyAction(reply)
                                    }
                                },
                                onLike: { 
                                    if let likeAction = onLike {
                                        likeAction(reply)
                                    }
                                },
                                isLiked: likedComments.contains(reply.id)
                            )
                        }
                    }
                }
                
                // 组间分隔线
                if group.parent.id != groupedComments.last?.parent.id {
                    Divider()
                        .padding(.horizontal, 16)
                        .padding(.vertical, 4)
                }
            }
        }
    }
}

/**
 * 历史人物评论单元格
 * 显示历史人物评论
 */
private struct HistoricalCommentCell: View {
    let comment: UserCommentModel
    let onReply: () -> Void
    let onLike: () -> Void
    let isLiked: Bool
    
    // 获取角色颜色
    private var characterColor: Color {
        switch comment.characterID?.lowercased() {
        case "einstein": return .blue
        case "shakespeare": return .purple
        case "davinci": return .green
        case "goku", "naruto": return .orange
        case "holmes": return .indigo
        case "confucius": return .teal
        default: return DesignSystem.Colors.primary
        }
    }
    
    // 获取角色领域
    private var characterField: String {
        switch comment.characterID?.lowercased() {
        case "einstein": return "科学家"
        case "shakespeare": return "文学家"
        case "davinci": return "艺术家"
        case "confucius": return "哲学家"
        case "goku", "naruto": return "动漫角色"
        case "holmes": return "侦探"
        default: return "历史人物"
        }
    }
    
    var body: some View {
        HStack(alignment: .top, spacing: 12) {
            // 历史人物头像
            ZStack {
                Circle()
                    .fill(characterColor.opacity(0.1))
                    .frame(width: 36, height: 36)
                
                Image(comment.userAvatar)
                    .resizable()
                    .aspectRatio(contentMode: .fill)
                    .frame(width: 32, height: 32)
                    .clipShape(Circle())
            }
            
            VStack(alignment: .leading, spacing: 4) {
                // 角色信息
                HStack(spacing: 6) {
                    Text(comment.username)
                        .font(.system(size: 14, weight: .semibold))
                        .foregroundColor(characterColor)
                    
                    // 领域标签
                    Text(characterField)
                        .font(.system(size: 11))
                        .padding(.horizontal, 6)
                        .padding(.vertical, 2)
                        .background(characterColor.opacity(0.1))
                        .foregroundColor(characterColor)
                        .cornerRadius(4)
                }
                
                // 评论内容
                Text(comment.content)
                    .font(.system(size: 15))
                    .lineSpacing(4)
                    .foregroundColor(.primary)
                    .fixedSize(horizontal: false, vertical: true)
                
                // 互动区
                HStack(spacing: 12) {
                    // 评论时间
                    Text(getFormattedTimeAgo(from: comment.datePosted))
                        .font(.system(size: 12))
                        .foregroundColor(.secondary)
                    
                    // 认同按钮
                    Button(action: onLike) {
                        HStack(spacing: 3) {
                            Image(systemName: isLiked ? "heart.fill" : "heart")
                                .font(.system(size: 12))
                                .foregroundColor(isLiked ? .red : .secondary)
                            
                            Text("\(comment.likes)")
                                .font(.system(size: 12))
                                .foregroundColor(isLiked ? .red : .secondary)
                        }
                    }
                    .buttonStyle(.plain)
                    
                    // 回复按钮
                    Button(action: onReply) {
                        Text("回复")
                            .font(.system(size: 12))
                            .foregroundColor(.secondary)
                    }
                    .buttonStyle(.plain)
                }
                .padding(.top, 2)
            }
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 8)
    }
}

