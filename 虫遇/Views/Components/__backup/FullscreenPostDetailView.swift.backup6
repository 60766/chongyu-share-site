import SwiftUI
import UIKit
import Combine

/**
 * 全屏沉浸式帖子详情视图
 * 提供沉浸式阅读和评论体验，支持多种手势导航和状态反馈
 */
struct FullscreenPostDetailView: View {
    // 帖子数据
    let post: UserPostModel
    
    // 上下文数据
    var currentIndex: Int? = nil
    var totalCount: Int? = nil
    
    // 回调函数
    var onDismiss: () -> Void = {}
    var onNextPost: (() -> Void)? = nil
    var onPreviousPost: (() -> Void)? = nil
    var onLikeComment: ((UserPostModel, UserCommentModel) -> Void)? = nil
    var onAddComment: ((UserPostModel, String, UUID?) -> Void)? = nil
    
    // 添加评论回复和点赞的处理函数
    var onReply: ((UserCommentModel) -> Void)? = nil
    var onLike: ((UserCommentModel) -> Void)? = nil
    
    // 状态管理
    @Environment(\.presentationMode) private var presentationMode
    @ObservedObject private var tabBarManager = TabBarManager.shared
    @State private var showShareSheet = false
    @State private var commentText: String = ""
    @State private var replyingTo: UserCommentModel? = nil
    @State private var scrollOffset: CGFloat = 0
    @State private var showNavBar: Bool = true
    @State private var isKeyboardVisible: Bool = false
    @State private var isFullImmersiveMode: Bool = false
    @State private var showEmojiPicker: Bool = false
    @State private var dragOffset: CGSize = .zero
    @State private var showEdgePreview: Bool = false
    @State private var showGestureTip: Bool = true
    @State private var scrollToCommentSection: Bool = false
    @State private var navBarOpacity: CGFloat = 0.0
    
    // 添加一个用于跟踪已点赞评论的集合
    @State private var likedComments: Set<UUID> = []
    
    // 添加过渡动画状态
    @State private var transitionState: TransitionState = .none
    
    // 触觉反馈
    private let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
    
    // 过渡状态枚举
    private enum TransitionState {
        case none
        case transitioning(direction: TransitionDirection, targetPost: UserPostModel)
        case dismissing
        
        enum TransitionDirection {
            case left, right
        }
    }
    
    // 获取设备颜色模式
    @Environment(\.colorScheme) var colorScheme
    
    // 滚动位置检测器
    private var scrollPositionDetector: some View {
        GeometryReader { innerGeometry in
            Color.clear.preference(
                key: ScrollOffsetPreferenceKey.self,
                value: innerGeometry.frame(in: .named("scrollView")).minY
            )
        }
        .frame(height: 0)
    }
    
    // 导航手势
    private var navigationGesture: some Gesture {
        DragGesture(minimumDistance: 20, coordinateSpace: .global)
            .onChanged { value in
                handleDragGestureChange(value)
            }
            .onEnded { value in
                handleDragGestureEnd(value)
            }
    }
    
    // 手势提示覆盖层
    private var gestureHintOverlay: some View {
        Group {
            if showGestureTip {
                VStack {
                    Spacer()
                    
                    HStack(spacing: 24) {
                        if onPreviousPost != nil && onNextPost != nil {
                            // 如果有上一条和下一条，显示左右滑动切换提示
                            Label("左右滑动切换", systemImage: "arrow.left.and.right")
                        } else if onPreviousPost == nil && onNextPost != nil {
                            // 如果是第一条，只显示向左滑动查看下一条
                            Label("向左滑动查看下一条", systemImage: "arrow.right")
                        } else if onPreviousPost != nil && onNextPost == nil {
                            // 如果是最后一条，只显示向右滑动查看上一条
                            Label("向右滑动查看上一条", systemImage: "arrow.left")
                        } else {
                            // 否则只显示右滑关闭提示
                            Label("右滑关闭", systemImage: "chevron.backward")
                        }
                        
                        Label("双击全屏", systemImage: "arrow.up.left.and.arrow.down.right")
                    }
                    .font(.system(size: 13))
                    .padding(.horizontal, 16)
                    .padding(.vertical, 8)
                    .background(Color.black.opacity(0.7))
                    .foregroundColor(.white)
                    .cornerRadius(20)
                    .padding(.bottom, 40)
                }
                .transition(.opacity)
            }
        }
        .animation(.easeInOut(duration: 0.2), value: showGestureTip)
    }
    
    // 边缘预览指示器覆盖层
    private var edgePreviewOverlay: some View {
        Group {
            if showEdgePreview {
                HStack {
                    if dragOffset.width > 0 {
                        if onPreviousPost != nil {
                            // 右滑预览指示 - 上一条
                            HStack {
                                Image(systemName: "chevron.left")
                                Text("上一条")
                            }
                            .transition(.opacity)
                            .padding(.horizontal, 16)
                            .padding(.vertical, 8)
                            .background(Material.ultraThinMaterial)
                            .cornerRadius(20)
                            .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                            .padding(.leading, 20)
                        } else {
                            // 右滑关闭指示
                            HStack {
                                Image(systemName: "xmark.circle")
                                Text("关闭")
                            }
                            .transition(.opacity)
                            .padding(.horizontal, 16)
                            .padding(.vertical, 8)
                            .background(Material.ultraThinMaterial)
                            .cornerRadius(20)
                            .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                            .padding(.leading, 20)
                        }
                        
                        Spacer()
                    } else if dragOffset.width < 0 && onNextPost != nil {
                        // 左滑预览指示 - 只有在有下一篇帖子时才显示
                        Spacer()
                        
                        HStack {
                            Text("下一条")
                            Image(systemName: "chevron.right")
                        }
                        .transition(.opacity)
                        .padding(.horizontal, 16)
                        .padding(.vertical, 8)
                        .background(Material.ultraThinMaterial)
                        .cornerRadius(20)
                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                        .padding(.trailing, 20)
                    } else if dragOffset.width < 0 && onNextPost == nil {
                        // 已经是最后一篇帖子，显示提示
                        Spacer()
                        
                        HStack {
                            Text("已是最后一条")
                            Image(systemName: "exclamationmark.circle")
                        }
                        .transition(.opacity)
                        .padding(.horizontal, 16)
                        .padding(.vertical, 8)
                        .background(Material.ultraThinMaterial)
                        .cornerRadius(20)
                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                        .padding(.trailing, 20)
                    }
                }
                .frame(maxWidth: .infinity)
                .padding(.top, 100)
            }
        }
    }
    
    // 优化文本布局的辅助方法
    private func enhanceTextLayout(_ text: String) -> String {
        // 添加适当的段落分隔，增强可读性
        // 实际应用中这里可以处理换行、段落等格式化
        return text
    }
    
    var body: some View {
        ZStack(alignment: .bottom) {
            // 背景 - 使用系统背景色而非固定色
            DesignSystem.Colors.background
                .edgesIgnoringSafeArea(.all)
            
            // 主内容区域
            GeometryReader { outerGeometry in
                if isFullImmersiveMode {
                    // 全屏模式内容 - 保持现有实现
                    FullscreenContentView(
                        post: post,
                        scrollOffset: $scrollOffset,
                        scrollToCommentSection: $scrollToCommentSection,
                        dragOffset: $dragOffset,
                        contentOpacity: contentOpacity,
                        onLike: { comment in
                            self.onLike?(comment)
                            onLikeComment?(post, comment)
                        },
                        onReply: { comment in
                            self.onReply?(comment)
                            self.replyingTo = comment
                            if isFullImmersiveMode {
                                isFullImmersiveMode = false
                            }
                        },
                        onTapGesture: handleDoubleTap,
                        isFullImmersiveMode: $isFullImmersiveMode,
                        replyingTo: $replyingTo
                    )
                    .edgesIgnoringSafeArea(.all)
                    .gesture(navigationGesture)
                    .overlay(gestureHintOverlay)
                    .overlay(edgePreviewOverlay)
                } else {
                    // 常规模式内容 - 优化设计
                    VStack(spacing: 0) {
                        // 自定义导航栏 - 更现代、更沉浸的设计
                        ZStack {
                            // 背景 - 使用超薄材质，随着滚动逐渐显示
                            Rectangle()
                                .fill(Material.ultraThinMaterial.opacity(min(0.98, max(0.5, scrollOffset / 300))))
                                .shadow(color: Color.black.opacity(scrollOffset > 50 ? 0.05 : 0), radius: 4, x: 0, y: 1)
                            
                            // 导航栏内容
                        HStack {
                                // 返回按钮 - 更精致的设计
                                Button(action: { dismiss() }) {
                                    Circle()
                                        .fill(Material.ultraThinMaterial)
                                        .frame(width: 36, height: 36)
                                        .overlay(
                                            Image(systemName: "chevron.left")
                                                .font(.system(size: 16, weight: .semibold))
                                                .foregroundColor(.primary)
                                        )
                                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                                }
                                .buttonStyle(ScaleButtonStyle())
                            
                            Spacer()
                            
                                // 标题 - 简约设计
                                if let current = currentIndex, let total = totalCount {
                                    Text("\(current)/\(total)")
                                        .font(.system(size: 15, weight: .medium))
                                        .foregroundColor(Color.primary.opacity(0.8))
                                        .padding(.horizontal, 12)
                                        .padding(.vertical, 4)
                                        .background(
                                            Capsule()
                                                .fill(Material.ultraThinMaterial)
                                        )
                                } else {
                                    Text("动态")
                                        .font(.system(size: 17, weight: .semibold))
                                        .foregroundColor(Color.primary.opacity(scrollOffset > 30 ? 1.0 : 0.0))
                                        .opacity(scrollOffset > 30 ? 1.0 : 0.0)
                                }
                            
                            Spacer()
                            
                                // 分享按钮 - 更精致的设计
                                Button(action: {
                                    let actionSheet = UIActivityViewController(
                                        activityItems: ["分享这个帖子"],
                                        applicationActivities: nil
                                    )
                                    
                                    if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
                                       let window = windowScene.windows.first,
                                       let rootVC = window.rootViewController {
                                        rootVC.present(actionSheet, animated: true)
                                    }
                                    
                                    let localFeedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
                                    localFeedbackGenerator.impactOccurred(intensity: 0.5)
                                }) {
                                    Circle()
                                        .fill(Material.ultraThinMaterial)
                                        .frame(width: 36, height: 36)
                                        .overlay(
                                            Image(systemName: "square.and.arrow.up")
                                                .font(.system(size: 16, weight: .semibold))
                                                .foregroundColor(.primary)
                                        )
                                        .shadow(color: Color.black.opacity(0.1), radius: 2, x: 0, y: 1)
                                }
                                .buttonStyle(ScaleButtonStyle())
                            }
                            .padding(.horizontal, 16)
                            .frame(height: 52)
                        }
                        .frame(height: 52)
                        .opacity(showNavBar ? 1 : 0)
                        .animation(.easeInOut(duration: 0.2), value: showNavBar)
                        
                        // 主内容区域 - 为评论输入栏增加足够的底部边距
                        mainContentArea
                            .padding(.bottom, 45) // 将底部边距从50减小为45
                    }
                }
            }
            
            // 评论输入框 - 仅在非全屏模式下显示
            if !isFullImmersiveMode {
                CommentInputBar(
                    commentText: $commentText,
                    replyingTo: $replyingTo,
                    onSendComment: { comment in
                        addComment(content: comment, replyToID: replyingTo?.id)
                        replyingTo = nil
                    }
                )
                .shadow(color: Color.black.opacity(0.04), radius: 2, y: -1) // 减轻阴影效果，使其更精细
                .onChange(of: replyingTo) { oldValue, newValue in
                    if newValue != nil {
                        scrollToCommentSection = true
                        
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
                            NotificationCenter.default.post(
                                name: Notification.Name("FocusCommentInput"),
                                object: nil
                            )
                        }
                    }
                }
            }
        }
        .statusBar(hidden: isFullImmersiveMode)
        .ignoresSafeArea(.all, edges: .all)
        .onAppear {
            // 隐藏TabBar
            tabBarManager.completelyHide()
            
            // 强制隐藏 Home Indicator 以增强沉浸感
            tabBarManager.setHomeIndicatorAutoHidden(true)
            
            // 额外设置
            DispatchQueue.main.async {
                if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
                   let window = windowScene.windows.first,
                   let rootViewController = window.rootViewController {
                    let _ = rootViewController.children.map { viewController in
                        viewController.setNeedsUpdateOfHomeIndicatorAutoHidden()
                        viewController.setNeedsUpdateOfScreenEdgesDeferringSystemGestures()
                    }
                    
                    window.layoutIfNeeded()
                }
            }
            
            setupOnAppear()
            
            // 配置ScrollView
            UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
            UIScrollView.appearance().automaticallyAdjustsScrollIndicatorInsets = false
            
            // 手动获取UIWindow并禁用安全区域
            DispatchQueue.main.async {
                if let windowScene = UIApplication.shared.connectedScenes.first as? UIWindowScene,
                   let window = windowScene.windows.first {
                    disableSafeAreaInViewHierarchy(window)
                }
            }
        }
        .onDisappear {
            // 恢复TabBar显示
            tabBarManager.show()
            
            // 恢复Home Indicator显示
            tabBarManager.setHomeIndicatorAutoHidden(false)
            
            // 还原ScrollView默认设置
            UIScrollView.appearance().contentInsetAdjustmentBehavior = .automatic
            UIScrollView.appearance().automaticallyAdjustsScrollIndicatorInsets = true
        }
        .onChange(of: scrollOffset) { oldValue, newValue in
            // 根据滚动位置更新导航栏显示状态
            withAnimation(.easeOut(duration: 0.2)) {
                navBarOpacity = min(1.0, scrollOffset / 200)
            }
        }
    }
    
    // MARK: - 子视图组件
    
    // 主内容区域 - 优化滚动体验
    private var mainContentArea: some View {
        GeometryReader { geometry in
            ScrollViewReader { scrollProxy in
                ScrollView {
                    // 滚动位置检测
                    scrollPositionDetector
                    
                    // 内容区
                    VStack(spacing: 0) {
                        // 帖子内容部分
                        makePostContentSection(for: post)
                            .id("postContent")
                        
                        // 移除灰色分隔线，使用透明间隔代替
                        Color.clear
                            .frame(height: 1)
                        
                        // 评论区部分
                        makeCommentsSection(for: post)
                            .id("comments")
                        
                        // 添加小填充区域确保滚动到底部
                        Color.clear
                            .frame(height: 1)
                                
                        // 添加柔和的分隔线
                        Rectangle()
                            .fill(Color(UIColor.separator).opacity(0.2))
                            .frame(height: 0.5)
                    }
                    .opacity(contentOpacity)
                    .offset(x: getContentOffset())
                }
                .background(Color.clear)
                .onAppear {
                        UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
                    
                    DispatchQueue.main.async {
                        UIScrollView.appearance().contentInset = .zero
                        UIScrollView.appearance().verticalScrollIndicatorInsets = .zero
                    }
                }
                .onDisappear {
                    UIScrollView.appearance().contentInsetAdjustmentBehavior = .automatic
                }
                .coordinateSpace(name: "scrollView")
                .onPreferenceChange(ScrollOffsetPreferenceKey.self) { offset in
                    handleScrollOffsetChange(offset)
                }
                .onChange(of: scrollToCommentSection) { _, newValue in
                    if newValue {
                        withAnimation {
                            scrollProxy.scrollTo("comments", anchor: .top)
                        }
                        scrollToCommentSection = false
                    }
                }
                .onChange(of: post.id) { _, _ in
                    withAnimation {
                        scrollProxy.scrollTo("postContent", anchor: .top)
                    }
                }
                .onChange(of: isFullImmersiveMode) { _, newValue in
                    UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
                    
                    DispatchQueue.main.async {
                        NotificationCenter.default.post(
                            name: NSNotification.Name("RefreshCommentInputLayout"),
                            object: nil
                        )
                    }
                }
            }
        }
        .gesture(navigationGesture)
        .onTapGesture(count: 2) {
            handleDoubleTap()
        }
        .overlay(gestureHintOverlay)
        .overlay(edgePreviewOverlay)
        .edgesIgnoringSafeArea(.all)
        .ignoresSafeArea(.all, edges: .all)
    }
    
    // 生成指定帖子的内容区域 - 采用更现代和简洁的设计
    private func makePostContentSection(for currentPost: UserPostModel) -> some View {
        VStack(alignment: .leading, spacing: DesignSystem.Spacing.s) {
            // 用户信息区域 - 极简设计
            HStack(spacing: DesignSystem.Spacing.m) {
                // 头像 - 简洁设计
                Image(currentPost.userAvatar)
                    .resizable()
                    .aspectRatio(contentMode: .fill)
                    .frame(width: 38, height: 38)
                    .clipShape(Circle())
                
                // 用户名和时间
                VStack(alignment: .leading, spacing: 2) {
                    Text(currentPost.username)
                        .font(.system(size: 15, weight: .medium))
                    
                    Text(currentPost.getFormattedTimeAgo())
                        .font(.system(size: 12))
                        .foregroundColor(.secondary)
                }
                
                Spacer()
                
                // 简化的关注按钮
                Button(action: {
                    let feedbackGenerator = UIImpactFeedbackGenerator(style: .light)
                    feedbackGenerator.impactOccurred(intensity: 0.5)
                }) {
                    Text("关注")
                        .font(.system(size: 13, weight: .medium))
                        .foregroundColor(DesignSystem.Colors.primary)
                        .padding(.horizontal, 12)
                        .padding(.vertical, 4)
                        .background(
                            Capsule()
                                .stroke(DesignSystem.Colors.primary, lineWidth: 1)
                        )
                }
                .buttonStyle(ScaleButtonStyle())
            }
            .padding(.horizontal, 16)
            .padding(.top, 12)
            .padding(.bottom, 8)
            
            // 正文内容 - 使用更宽松的间距
            Text(currentPost.content)
                .font(.system(size: 16))
                .lineSpacing(5)
                .fixedSize(horizontal: false, vertical: true)
                .padding(.horizontal, 16)
                .padding(.bottom, 12)
            
            // 图片内容 - 简化布局
            if !currentPost.images.isEmpty {
                if currentPost.images.count == 1 {
                    // 单图显示
                    Image(currentPost.images[0])
                        .resizable()
                        .scaledToFill()
                        .frame(maxHeight: 240)
                        .clipShape(RoundedRectangle(cornerRadius: 8))
                        .padding(.horizontal, 16)
                } else {
                    // 多图网格 - 简化视觉效果
                    LazyVGrid(columns: [GridItem(.flexible()), GridItem(.flexible())], spacing: 8) {
                        ForEach(currentPost.images, id: \.self) { image in
                            Image(image)
                                .resizable()
                                .scaledToFill()
                                .frame(height: 160)
                                .clipShape(RoundedRectangle(cornerRadius: 8))
                        }
                    }
                    .padding(.horizontal, 16)
                }
                .padding(.bottom, 12)
            }
            
            // 互动按钮区 - 极简风格
            HStack(spacing: 24) {
                // 点赞按钮
                Button(action: {
                    let generator = UIImpactFeedbackGenerator(style: .light)
                    generator.impactOccurred(intensity: 0.5)
                }) {
                    Label(
                        "\(currentPost.likes)",
                        systemImage: currentPost.isLikedByCurrentUser ? "heart.fill" : "heart"
                    )
                    .font(.system(size: 14))
                    .foregroundColor(currentPost.isLikedByCurrentUser ? .red : .secondary)
                }
                
                // 评论按钮
                Button(action: {
                    let generator = UIImpactFeedbackGenerator(style: .light)
                    generator.impactOccurred(intensity: 0.5)
                    scrollToCommentSection = true
                }) {
                    Label(
                        "\(currentPost.comments.count)",
                        systemImage: "bubble.left"
                    )
                    .font(.system(size: 14))
                    .foregroundColor(.secondary)
                }
                
                // 收藏按钮
                Button(action: {
                    let generator = UIImpactFeedbackGenerator(style: .light)
                    generator.impactOccurred(intensity: 0.5)
                }) {
                    Image(systemName: currentPost.isBookmarkedByCurrentUser ? "bookmark.fill" : "bookmark")
                        .font(.system(size: 14))
                        .foregroundColor(currentPost.isBookmarkedByCurrentUser ? DesignSystem.Colors.primary : .secondary)
                }
                
                Spacer()
                
                // 分享按钮
                Button(action: {
                    let generator = UIImpactFeedbackGenerator(style: .light)
                    generator.impactOccurred(intensity: 0.5)
                    showShareSheet = true
                }) {
                    Image(systemName: "square.and.arrow.up")
                        .font(.system(size: 14))
                        .foregroundColor(.secondary)
                }
            }
            .padding(.horizontal, 16)
            .padding(.bottom, 16)
            
            // 简单的分隔线
            Divider()
                .padding(.horizontal, 16)
        }
        .background(Color(UIColor.systemBackground))
    }
    
    // 生成指定帖子的评论区域 - 简洁风格
    private func makeCommentsSection(for currentPost: UserPostModel) -> some View {
        VStack(alignment: .leading, spacing: 0) {
            // 评论区标题
            HStack {
                Text("评论")
                    .font(.system(size: 16, weight: .medium))
                
                Text("(\(currentPost.comments.count))")
                    .font(.system(size: 14))
                    .foregroundColor(.secondary)
                
                Spacer()
                
                // 排序按钮 - 简化为单个按钮
                Button(action: {}) {
                    HStack(spacing: 4) {
                        Text("最新")
                            .font(.system(size: 14))
                        Image(systemName: "chevron.down")
                            .font(.system(size: 12))
                    }
                    .foregroundColor(.secondary)
                }
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 12)
            
            // 评论列表
            if currentPost.comments.isEmpty {
                // 无评论状态
                VStack(spacing: 8) {
                    Image(systemName: "bubble.left")
                        .font(.system(size: 24))
                        .foregroundColor(.secondary.opacity(0.5))
                        .padding(.bottom, 4)
                    
                    Text("暂无评论")
                        .font(.system(size: 15))
                        .foregroundColor(.secondary)
                    
                    Text("成为第一个评论的人吧")
                        .font(.system(size: 13))
                        .foregroundColor(.secondary.opacity(0.7))
                }
                .frame(maxWidth: .infinity)
                .padding(.vertical, 30)
            } else {
                // 有评论时显示列表 - 扁平简洁风格
                ForEach(currentPost.comments) { comment in
                    VStack(alignment: .leading, spacing: 0) {
                        HStack(alignment: .top, spacing: 12) {
                            // 用户头像
                            Image(comment.userAvatar)
                                .resizable()
                                .aspectRatio(contentMode: .fill)
                                .frame(width: 36, height: 36)
                                .clipShape(Circle())
                            
                            VStack(alignment: .leading, spacing: 4) {
                                // 用户信息
                                HStack(alignment: .center, spacing: 6) {
                                    Text(comment.username)
                                        .font(.system(size: 14, weight: .medium))
                                    
                                    // 虚拟角色标识
                                    if comment.isVirtualCharacter {
                                        Text("历史人物")
                                            .font(.system(size: 10))
                                            .padding(.horizontal, 6)
                                            .padding(.vertical, 2)
                                            .background(DesignSystem.Colors.primary.opacity(0.1))
                                            .foregroundColor(DesignSystem.Colors.primary)
                                            .clipShape(Capsule())
                                    }
                                    
                                    Spacer()
                                    
                                    // 评论时间
                                    Text(getFormattedDate(from: comment.datePosted))
                                        .font(.system(size: 12))
                                        .foregroundColor(.secondary)
                                }
                                
                                // 评论内容
                                Text(comment.content)
                                    .font(.system(size: 15))
                                    .lineSpacing(4)
                                    .padding(.vertical, 4)
                                
                                // 评论互动按钮
                                HStack(spacing: 16) {
                                    // 点赞按钮
                                    Button(action: {
                                        onLike?(comment)
                                    }) {
                                        Label(
                                            "\(comment.likes)",
                                            systemImage: likedComments.contains(comment.id) ? "heart.fill" : "heart"
                                        )
                                        .font(.system(size: 12))
                                        .foregroundColor(likedComments.contains(comment.id) ? .red : .secondary)
                                    }
                                    
                                    // 回复按钮
                                    Button(action: {
                                        self.replyingTo = comment
                                    }) {
                                        Text("回复")
                                            .font(.system(size: 12))
                                            .foregroundColor(.secondary)
                                    }
                                }
                            }
                        }
                        .padding(.horizontal, 16)
                        .padding(.vertical, 12)
                        
                        Divider()
                            .padding(.leading, 64)
                    }
                }
            }
        }
        .background(Color(UIColor.systemBackground))
    }
    
    // MARK: - 事件处理方法
    
    // 处理滚动偏移变化
    private func handleScrollOffsetChange(_ offset: CGFloat) {
        withAnimation(.easeOut) {
            scrollOffset = -offset
            
            // 向下滚动时隐藏导航栏
            if scrollOffset > 20 && offset < 0 {
                showNavBar = false
            } else if offset > 0 || scrollOffset < 10 {
                // 回到顶部或微小滚动时显示导航栏
                showNavBar = true
            }
        }
    }
    
    // 初始设置
    private func setupOnAppear() {
        // 准备触觉反馈
        feedbackGenerator.prepare()
        
        // 重置评论框状态
        commentText = ""
        replyingTo = nil
        
        // 设置初始滚动位置
        scrollOffset = 0
        
        // 显示手势提示，然后自动隐藏
        showGestureTip = true
        DispatchQueue.main.asyncAfter(deadline: .now() + 3) {
            withAnimation {
                showGestureTip = false
            }
        }
        
        // 确保在初始化时输入框可见
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.1) {
            // 发送布局刷新通知
            NotificationCenter.default.post(
                name: NSNotification.Name("RefreshCommentInputLayout"),
                object: nil
            )
        }
    }
    
    // 处理双击
    private func handleDoubleTap() {
        withAnimation(.spring(response: 0.3, dampingFraction: 0.7)) {
            isFullImmersiveMode.toggle()
            
            // 全屏模式时需要立即隐藏状态栏及底部安全区域
            if isFullImmersiveMode {
                // 更改ScrollView的contentInsetAdjustmentBehavior以忽略安全区域
                UIScrollView.appearance().contentInsetAdjustmentBehavior = .never
            } else {
                // 恢复默认行为
                UIScrollView.appearance().contentInsetAdjustmentBehavior = .automatic
            }
        }
        
        // 触觉反馈
        let feedbackType: UIImpactFeedbackGenerator.FeedbackStyle = isFullImmersiveMode ? .rigid : .light
        let feedback = UIImpactFeedbackGenerator(style: feedbackType)
        feedback.impactOccurred()
    }
    
    // 处理拖动手势变化
    private func handleDragGestureChange(_ value: DragGesture.Value) {
        // 计算拖动的方向和距离
        dragOffset = value.translation
        
        // 仅在水平拖动时显示边缘预览
        if abs(dragOffset.width) > abs(dragOffset.height) && abs(dragOffset.width) > 50 {
            if !showEdgePreview {
                showEdgePreview = true
                
                // 轻微触觉反馈
                let lighterFeedback = UIImpactFeedbackGenerator(style: .light)
                lighterFeedback.impactOccurred(intensity: 0.5)
            }
        } else {
            showEdgePreview = false
        }
    }
    
    // 处理拖动手势结束
    private func handleDragGestureEnd(_ value: DragGesture.Value) {
        let translation = value.translation
        let velocity = value.predictedEndTranslation.width - translation.width
        
        // 如果拖动不够，或者垂直拖动大于水平拖动，则复位
        if abs(translation.width) < 60 && abs(velocity) < 300 || abs(translation.width) < abs(translation.height) {
            // 复位动画
            withAnimation(.spring(response: 0.3, dampingFraction: 0.7)) {
                dragOffset = .zero
                showEdgePreview = false
            }
            return
        }
        
        // 触觉反馈
        let feedbackGenerator = UIImpactFeedbackGenerator(style: .medium)
        feedbackGenerator.impactOccurred()
        
        // 存储导航动作
        var targetPostAction: (() -> Void)? = nil
        
        if translation.width > 0 {
            // 向右滑动查看上一篇帖子或关闭
            // 如果没有显示任何上一篇帖子的回调，则关闭视图
            if onPreviousPost == nil {
                // 关闭当前视图
                onDismiss()
                return
            }
            
            if let previousPostCallback = onPreviousPost {
                // 从父视图获取上一篇
                targetPostAction = previousPostCallback
            } else {
                return // 无上一篇
            }
        } else {
            // 向左滑动查看下一篇帖子
            if let nextPostCallback = onNextPost {
                // 从父视图获取下一篇
                targetPostAction = nextPostCallback
            } else {
                return // 无下一篇
            }
        }
        
        // 执行目标帖子变更（在父视图中切换到上一篇/下一篇）
        targetPostAction?()
        
        // 动画滑动到新位置
        withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
            dragOffset = .zero
        }
        
        // 动画完成后重置状态
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) {
            self.scrollOffset = 0
            self.showEdgePreview = false
        }
    }
    
    // 关闭视图
    private func dismiss() {
        // 触发关闭回调
        onDismiss()
    }
    
    // 发送评论
    private func handleSendComment() {
        let trimmedText = commentText.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmedText.isEmpty else { return }
        
        // 触发评论回调
        onAddComment?(post, trimmedText, replyingTo?.id)
        
        // 触觉反馈 - 使用成功类型
        let feedback = UINotificationFeedbackGenerator()
        feedback.notificationOccurred(.success)
        
        // 清空输入
        commentText = ""
        // 重置回复状态
        replyingTo = nil
        // 关闭表情选择器
        showEmojiPicker = false
    }
    
    // 计算内容偏移量 - 用于滑动切换动画
    private func getContentOffset() -> CGFloat {
        return dragOffset.width
    }
    
    // 当前应显示的帖子 - 根据过渡状态决定显示内容
    private var currentDisplayPost: UserPostModel {
        // 默认显示当前帖子
        return post
    }
    
    // 评论栏透明度 - 根据状态决定是否显示
    private var commentBarOpacity: Double {
        // 全屏模式下，隐藏评论栏
        if isFullImmersiveMode {
            return 0
        }
        
        // 拖动时，也隐藏评论栏
        if abs(dragOffset.width) > 20 {
            return 0
        }
        
        // 默认显示
        return 1
    }
    
    // 内容透明度 - 用于切换动画
    private var contentOpacity: Double {
        // 在拖动切换时，根据拖动距离动态调整透明度
        if abs(dragOffset.width) > 0 {
            // 最多降低到0.7
            return max(1.0 - Double(abs(dragOffset.width)) / 500.0, 0.7)
        }
        return 1
    }
    
    // MARK: - 新增的安全区域处理方法
    
    /**
     * 递归禁用视图层级中的安全区域
     */
    private func disableSafeAreaInViewHierarchy(_ view: UIView) {
        if let scrollView = view as? UIScrollView {
            scrollView.contentInsetAdjustmentBehavior = .never
        }
        
        for subview in view.subviews {
            disableSafeAreaInViewHierarchy(subview)
        }
    }
    
    // 判断是否为系统图片名称
    private func isSystemImageName(_ name: String) -> Bool {
        // 系统图片名称通常不包含文件扩展名或路径分隔符
        return !name.contains(".") && !name.contains("/")
    }
    
    // MARK: - 处理评论相关功能
    
    // 添加评论
    private func addComment(content: String, replyToID: UUID? = nil) {
        guard !content.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return }
        
        // 创建新评论
        _ = UserCommentModel(
            username: "当前用户", // 应替换为实际用户名
            userAvatar: "current_user_avatar", // 应替换为实际头像
            content: content,
            datePosted: Date(),
            likes: 0,
            isLikedByCurrentUser: false,
            isVirtualCharacter: false,
            characterID: nil
        )
        
        // 使用post的addComment方法创建新的post对象
        if let onAddCommentHandler = onAddComment {
            onAddCommentHandler(post, content, replyToID)
        }
        
        // 添加成功后给予触觉反馈
        let generator = UIImpactFeedbackGenerator(style: .medium)
        generator.impactOccurred()
    }
}

/**
 * 滚动偏移量首选项键
 */
struct ScrollOffsetPreferenceKey: PreferenceKey {
    static var defaultValue: CGFloat = 0
    static func reduce(value: inout CGFloat, nextValue: () -> CGFloat) {
        value = nextValue()
    }
}

/**
 * 水平滑动模态呈现修饰符
 * 用于替换默认的从下往上的模态呈现方式
 */
struct PostDetailHorizontalModalTransition: ViewModifier {
    let isPresented: Binding<Bool>
    let onDismiss: (() -> Void)?
    let content: () -> AnyView
    let direction: ModalDirection
    
    enum ModalDirection {
        case fromRight
        case fromLeft
    }
    
    @State private var internalIsPresented = false
    @State private var slideInPosition = CGSize.zero
    
    init<V: View>(isPresented: Binding<Bool>, direction: ModalDirection = .fromRight, onDismiss: (() -> Void)? = nil, @ViewBuilder content: @escaping () -> V) {
        self.isPresented = isPresented
        self.onDismiss = onDismiss
        self.content = { AnyView(content()) }
        self.direction = direction
    }
    
    func body(content: Content) -> some View {
        ZStack {
            content
                .onChange(of: isPresented.wrappedValue) { oldValue, newValue in
                    if newValue && !internalIsPresented {
                        // 根据方向从侧面滑入
                        let screenWidth = UIScreen.main.bounds.width
                        slideInPosition = CGSize(
                            width: direction == .fromRight ? screenWidth : -screenWidth, 
                            height: 0
                        )
                        withAnimation(.linear(duration: 0.01)) {
                            internalIsPresented = true
                        }
                        
                        // 在下一帧执行滑入动画
                        DispatchQueue.main.async {
                            withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
                                slideInPosition = .zero
                            }
                        }
                    } else if !newValue && internalIsPresented {
                        // 向侧面滑出
                        let screenWidth = UIScreen.main.bounds.width
                        withAnimation(.spring(response: 0.4, dampingFraction: 0.8)) {
                            slideInPosition = CGSize(
                                width: direction == .fromRight ? screenWidth : -screenWidth, 
                                height: 0
                            )
                        }
                        
                        // 动画完成后关闭
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) {
                            internalIsPresented = false
                            onDismiss?()
                        }
                    }
                }
            
            if internalIsPresented {
                self.content()
                    .edgesIgnoringSafeArea(.all)
                    .offset(x: slideInPosition.width, y: 0)
                    .transition(.identity)
                    .zIndex(999)
            }
        }
    }
}

// 扩展 View 以添加自定义模态呈现修饰符
extension View {
    func postDetailHorizontalModal<Content: View>(
        isPresented: Binding<Bool>,
        direction: PostDetailHorizontalModalTransition.ModalDirection = .fromRight,
        onDismiss: (() -> Void)? = nil,
        @ViewBuilder content: @escaping () -> Content
    ) -> some View {
        modifier(PostDetailHorizontalModalTransition(isPresented: isPresented, direction: direction, onDismiss: onDismiss, content: content))
    }
}

