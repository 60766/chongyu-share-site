    /**
     * 创建评论区
     * 包含评论标题和评论列表
     */
    private func makeCommentsSection() -> some View {
        VStack(spacing: 0) {
            // 评论区标题
            HStack {
                HStack(spacing: 6) {
                    Text("评论")
                        .font(.system(size: 16, weight: .medium))
                    
                    // 显示评论总数
                    Text("(\(viewModel.post.getTotalCommentsCount()))")
                        .font(.system(size: 15))
                        .foregroundColor(.secondary)
                }
                
                Spacer()
                
                // 排序按钮
                Button(action: {
                    // 触觉反馈
                    let generator = UIImpactFeedbackGenerator(style: .light)
                    generator.impactOccurred()
                    
                    // 切换排序方式 - 实际应用中可以添加具体逻辑
                }) {
                    HStack(spacing: 4) {
                        Text("最新")
                            .font(.system(size: 14))
                        Image(systemName: "chevron.down")
                            .font(.system(size: 10))
                    }
                    .foregroundColor(.secondary)
                    .padding(.horizontal, 10)
                    .padding(.vertical, 5)
                    .background(Color.secondary.opacity(0.06))
                    .cornerRadius(15)
                }
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 14)
            
            // 分隔线
            Rectangle()
                .fill(Color.gray.opacity(0.08))
                .frame(height: 1)
                .padding(.horizontal, 16)
            
            // 评论列表
            if viewModel.post.getTopLevelComments().isEmpty {
                // 无评论状态
                VStack(spacing: 20) {
                    Image(systemName: "bubble.left")
                        .font(.system(size: 40))
                        .foregroundColor(.secondary.opacity(0.4))
                        .padding(.top, 30)
                    
                    Text("暂无评论，快来发表你的看法吧")
                        .font(.system(size: 15))
                        .foregroundColor(.secondary)
                        .multilineTextAlignment(.center)
                    
                    Spacer()
                }
                .frame(height: 180)
            } else {
                // 显示评论列表
                LazyVStack(spacing: 0, pinnedViews: .sectionHeaders) {
                    ForEach(viewModel.post.getTopLevelComments()) { comment in
                        CommentView(
                            comment: comment,
                            onLike: {
                                // 更新点赞状态
                                viewModel.commentManager.likeComment(commentId: comment.id)
                                
                                // 触发回调
                                onLike?(comment)
                            },
                            onReply: { replyingComment in
                                // 设置正在回复的评论
                                replyingTo = replyingComment
                                
                                // 显示评论输入框
                                showingCommentTextArea = true
                            },
                            showReplies: expandedPostID == comment.id,
                            onToggleReplies: {
                                // 切换显示回复的状态
                                withAnimation {
                                    if expandedPostID == comment.id {
                                        expandedPostID = nil
                                    } else {
                                        expandedPostID = comment.id
                                    }
                                }
                            }
                        )
                        .padding(.bottom, comment.id == viewModel.post.getTopLevelComments().last?.id ? 60 : 0)
                    }
                }
            }
        }
    }
    
    /**
     * 异步预加载图片
     * 提前加载下一篇/上一篇帖子的图片，避免切换时出现延迟
     */
    private func preloadImagesForPostAsync(_ post: UserPostModel) async {
        // 确保在后台线程执行
        await Task.yield()
        
        // 遍历所有图片并预加载
        for imageName in post.images {
            if let image = UIImage(named: imageName) {
                // 简单地访问image属性即可触发UIImage的预加载
                _ = image.size
            }
        }
    }
    
    /**
     * 异步预加载评论
     * 提前处理下一篇/上一篇帖子的评论数据，避免切换时出现延迟
     */
    private func preloadCommentsForPostAsync(_ post: UserPostModel) async {
        // 确保在后台线程执行
        await Task.yield()
        
        // 创建临时CommentManager实例来处理评论数据
        _ = CommentManager(post: post)
    }
}

/**
 * 帖子详情视图 - 使用ObservableObject管理数据
 */
class FullscreenPostDetailViewModel: ObservableObject {
    @Published var post: UserPostModel
    @Published var commentManager: CommentManager
    
    // 添加缓存属性来支持预加载
    private var nextPostCache: UserPostModel?
    private var prevPostCache: UserPostModel?
    
    init(post: UserPostModel) {
        self.post = post
        self.commentManager = CommentManager(post: post)
    }
    
    // 添加更新帖子的方法
    func updatePost(_ newPost: UserPostModel) {
        // 立即更新数据模型
        self.post = newPost
        self.commentManager = CommentManager(post: newPost)
        
        // 清除缓存
        nextPostCache = nil
        prevPostCache = nil
    }
    
    // 预加载下一篇帖子内容
    func preloadNextPost(_ nextPost: UserPostModel?) {
        guard let nextPost = nextPost else { return }
        nextPostCache = nextPost
    }
    
    // 预加载上一篇帖子内容
    func preloadPrevPost(_ prevPost: UserPostModel?) {
        guard let prevPost = prevPost else { return }
        prevPostCache = prevPost
    }
    
    // 获取预加载的下一篇帖子
    func getNextPostCache() -> UserPostModel? {
        return nextPostCache
    }
    
    // 获取预加载的上一篇帖子
    func getPrevPostCache() -> UserPostModel? {
        return prevPostCache
    }
    
    // 清除缓存
    func clearNextPostCache() {
        nextPostCache = nil
    }
    
    // 同步帖子
    func synchronizePost(id: UUID) {
        print("🔄 开始同步帖子: \(id.uuidString)")
        
        // 获取所有帖子
        let allPosts = ModelData.samplePosts
        
        // 查找匹配ID的帖子
        if let foundPost = allPosts.first(where: { $0.id.uuidString == id.uuidString }) {
            print("✅ 找到匹配的帖子: \(foundPost.id.uuidString)")
            
            // 更新当前帖子
            updatePost(foundPost)
            
            // 清除缓存以避免潜在问题
            nextPostCache = nil
            prevPostCache = nil
            
            print("✅ 帖子同步完成")
        } else {
            print("❌ 无法找到ID为 \(id.uuidString) 的帖子")
        }
    }
}

/**
 * 兼容层 - 为了满足TabBarManager中的引用
 * 这是一个空实现，以解决编译错误
 */
struct FullscreenContentView {
    typealias FullscreenContent = AnyView
    
    let content: FullscreenContent
    
    init<Content: View>(_ content: Content) {
        self.content = AnyView(content)
    }
}

// 在文件末尾添加黑洞相关的辅助视图

/**
 * 黑洞粒子环视图
 * 创建环形的粒子效果环绕黑洞
 */
struct BlackHoleParticleRing: View {
    @State private var rotation: Double = 0
    
    var body: some View {
        ZStack {
            // 创建多层粒子环，每层旋转角度和大小略有不同
            ForEach(0..<3) { ringIndex in
                ZStack {
                    ForEach(0..<180) { index in
                        let size = CGFloat.random(in: 1.0...2.5)
                        let opacity = Double.random(in: 0.2...0.8)
                        let angle = Double(index) * (360.0 / 180.0)
                        let radius = Double(self.getFrame().width / 2) * (1.0 - Double(ringIndex) * 0.05)
                        let xPos = cos(angle * .pi / 180) * radius
                        let yPos = sin(angle * .pi / 180) * radius
                        
                        Circle()
                            .fill(Color.white.opacity(opacity))
                            .frame(width: size, height: size)
                            .position(x: self.getFrame().width / 2 + CGFloat(xPos),
                                     y: self.getFrame().height / 2 + CGFloat(yPos))
                            .blur(radius: 0.2)
                    }
                }
                .rotationEffect(.degrees(rotation + Double(ringIndex) * 30))
            }
        }
        .onAppear {
            // 使用异步调用避免在视图更新过程中修改状态
            DispatchQueue.main.async {
                // 添加缓慢旋转动画
                withAnimation(.linear(duration: 300).repeatForever(autoreverses: false)) {
                    rotation = 360
                }
            }
        }
    }
    
    private func getFrame() -> CGRect {
        return CGRect(x: 0, y: 0, width: UIScreen.main.bounds.width * 0.65, height: UIScreen.main.bounds.width * 0.65)
    }
}

/**
 * 评论管理器
 * 用于管理帖子的评论数据
 */
class CommentManager: ObservableObject {
    @Published var post: UserPostModel
    
    init(post: UserPostModel) {
        self.post = post
    }
    
    func addComment(content: String, parentCommentId: UUID? = nil, replyToUsername: String? = nil) {
        // 创建新评论
        let newComment = UserCommentModel(
            username: "当前用户",
            userAvatar: "person.circle.fill",
            content: content,
            datePosted: Date(),
            likes: 0,
            isVirtualCharacter: false,
            characterID: nil,
            parentCommentId: parentCommentId,
            replyToUsername: replyToUsername
        )
        
        // 更新帖子
        var updatedPost = post
        
        // 如果是回复到评论
        if let parentId = parentCommentId {
            // 找到父评论并添加回复
            let commentIndex = updatedPost.comments.firstIndex { $0.id == parentId }
            if let index = commentIndex {
                updatedPost.comments[index].replies.append(newComment)
            }
        } else {
            // 直接添加为顶级评论
            updatedPost.comments.append(newComment)
        }
        
        // 更新状态
        post = updatedPost
    }
    
    func likeComment(commentId: UUID) {
        var updatedPost = post
        
        // 递归函数查找并更新评论
        func updateCommentLike(in comments: inout [UserCommentModel], commentId: UUID) -> Bool {
            // 检查当前级别的评论
            for i in 0..<comments.count {
                if comments[i].id == commentId {
                    // 更新点赞状态
                    comments[i].isLikedByCurrentUser.toggle()
                    
                    // 更新点赞数
                    if comments[i].isLikedByCurrentUser {
                        comments[i].likes += 1
                    } else {
                        comments[i].likes = max(0, comments[i].likes - 1)
                    }
                    
                    return true
                }
                
                // 递归检查回复
                var replies = comments[i].replies
                if updateCommentLike(in: &replies, commentId: commentId) {
                    comments[i].replies = replies
                    return true
                }
            }
            
            return false
        }
        
        // 执行更新
        var comments = updatedPost.comments
        if updateCommentLike(in: &comments, commentId: commentId) {
            updatedPost.comments = comments
            post = updatedPost
        }
    }
}

/**
 * 评论视图
 * 用于显示单条评论及其回复
 */
struct CommentView: View {
    let comment: UserCommentModel
    let onLike: () -> Void
    let onReply: (UserCommentModel) -> Void
    let showReplies: Bool
    let onToggleReplies: () -> Void
    
    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            // 评论内容
            HStack(alignment: .top, spacing: 12) {
                // 用户头像
                if comment.isVirtualCharacter {
                    if let characterImage = UIImage(named: comment.userAvatar) {
                        Image(uiImage: characterImage)
                            .resizable()
                            .aspectRatio(contentMode: .fill)
                            .frame(width: 36, height: 36)
                            .clipShape(Circle())
                    } else {
                        Image(systemName: comment.userAvatar)
                            .font(.system(size: 18))
                            .foregroundColor(.purple)
                            .frame(width: 36, height: 36)
                            .background(Color.purple.opacity(0.1))
                            .clipShape(Circle())
                    }
                } else {
                    Image(systemName: "person.circle.fill")
                        .font(.system(size: 28))
                        .foregroundColor(.gray)
                        .frame(width: 36, height: 36)
                }
                
                VStack(alignment: .leading, spacing: 4) {
                    // 用户名和角色标识
                    HStack(spacing: 6) {
                        Text(comment.username)
                            .font(.system(size: 14, weight: .medium))
                        
                        if comment.isVirtualCharacter {
                            Text("虚拟角色")
                                .font(.system(size: 11))
                                .padding(.horizontal, 6)
                                .padding(.vertical, 2)
                                .background(Color.purple.opacity(0.1))
                                .foregroundColor(.purple)
                                .cornerRadius(4)
                        }
                        
                        Text(comment.getFormattedTimeAgo())
                            .font(.system(size: 12))
                            .foregroundColor(.secondary.opacity(0.7))
                    }
                    
                    // 回复提示
                    if let replyTo = comment.replyToUsername, !replyTo.isEmpty {
                        HStack(spacing: 4) {
                            Text("回复")
                                .font(.system(size: 13))
                                .foregroundColor(.secondary.opacity(0.8))
                            
                            Text(replyTo)
                                .font(.system(size: 13, weight: .medium))
                                .foregroundColor(Color.blue.opacity(0.8))
                        }
                        .padding(.top, 2)
                    }
                    
                    // 评论内容
                    Text(comment.content)
                        .font(.system(size: 15))
                        .lineSpacing(4)
                        .padding(.top, 4)
                    
                    // 操作按钮
                    HStack(spacing: 16) {
                        // 点赞按钮
                        Button(action: {
                            onLike()
                        }) {
                            HStack(spacing: 4) {
                                Image(systemName: comment.isLikedByCurrentUser ? "heart.fill" : "heart")
                                    .font(.system(size: 13))
                                    .foregroundColor(comment.isLikedByCurrentUser ? .red : .secondary)
                                
                                Text("\(comment.likes)")
                                    .font(.system(size: 12))
                                    .foregroundColor(comment.isLikedByCurrentUser ? .red.opacity(0.8) : .secondary)
                            }
                        }
                        .buttonStyle(PlainButtonStyle())
                        
                        // 回复按钮
                        Button(action: {
                            onReply(comment)
                        }) {
                            Text("回复")
                                .font(.system(size: 12))
                                .foregroundColor(.secondary)
                        }
                        .buttonStyle(PlainButtonStyle())
                        
                        // 显示回复数量
                        if !comment.replies.isEmpty {
                            Button(action: {
                                onToggleReplies()
                            }) {
                                HStack(spacing: 4) {
                                    Text(showReplies ? "收起" : "查看\(comment.replies.count)条回复")
                                        .font(.system(size: 12))
                                        .foregroundColor(.blue.opacity(0.8))
                                    
                                    if !showReplies {
                                        Image(systemName: "chevron.down")
                                            .font(.system(size: 9, weight: .medium))
                                            .foregroundColor(.blue.opacity(0.8))
                                    } else {
                                        Image(systemName: "chevron.up")
                                            .font(.system(size: 9, weight: .medium))
                                            .foregroundColor(.blue.opacity(0.8))
                                    }
                                }
                            }
                            .buttonStyle(PlainButtonStyle())
                        }
                    }
                    .padding(.top, 8)
                }
                .frame(maxWidth: .infinity, alignment: .leading)
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 14)
            
            // 回复列表
            if showReplies && !comment.replies.isEmpty {
                VStack(spacing: 0) {
                    ForEach(comment.replies) { reply in
                        HStack(alignment: .top, spacing: 12) {
                            // 缩进
                            Rectangle()
                                .fill(Color.clear)
                                .frame(width: 36)
                            
                            // 回复内容 - 使用嵌套的CommentView但不显示嵌套回复
                            CommentView(
                                comment: reply,
                                onLike: onLike,
                                onReply: onReply,
                                showReplies: false,
                                onToggleReplies: {}
                            )
                        }
                        .padding(.leading, 16)
                    }
                }
                .padding(.top, -10)
            }
            
            // 分隔线
            Divider()
                .padding(.leading, 64)
                .padding(.trailing, 16)
        }
    }
}

/**
 * 评论模型扩展 - 用于显示格式化时间
 */

/**
 * 评论输入视图
 * 用于输入评论和回复
 */
struct CommentInputView: View {
    @ObservedObject var commentManager: CommentManager
    @State private var commentText: String = ""
    @State private var isReplying: Bool = false
    @State private var replyToComment: UserCommentModel? = nil
    
    var body: some View {
        VStack(spacing: 0) {
            // 回复状态栏 - 仅在回复时显示
            if isReplying, let replyTo = replyToComment {
                HStack {
                    Text("回复")
                        .font(.system(size: 14))
                        .foregroundColor(.secondary)
                    
                    Text(replyTo.username)
                        .font(.system(size: 14, weight: .medium))
                        .foregroundColor(.blue)
                    
                    Spacer()
                    
                    Button(action: {
                        withAnimation {
                            isReplying = false
                            replyToComment = nil
                        }
                    }) {
                        Image(systemName: "xmark.circle.fill")
                            .font(.system(size: 16))
                            .foregroundColor(.secondary)
                    }
                }
                .padding(.horizontal, 16)
                .padding(.vertical, 8)
                .background(Color(.systemGray6).opacity(0.5))
            }
            
            // 输入区域
            HStack(spacing: 12) {
                // 用户头像
                Image(systemName: "person.circle.fill")
                    .font(.system(size: 24))
                    .foregroundColor(.gray)
                
                // 输入框
                ZStack(alignment: .trailing) {
                    TextField("添加评论...", text: $commentText)
                        .padding(.vertical, 8)
                        .padding(.horizontal, 12)
                        .background(Color(.systemGray6).opacity(0.5))
                        .cornerRadius(20)
                    
                    // 发送按钮
                    if !commentText.isEmpty {
                        Button(action: {
                            // 发送评论
                            if isReplying, let replyTo = replyToComment {
                                commentManager.addComment(
                                    content: commentText,
                                    parentCommentId: replyTo.id,
                                    replyToUsername: replyTo.username
                                )
                            } else {
                                commentManager.addComment(content: commentText)
                            }
                            
                            // 重置状态
                            commentText = ""
                            isReplying = false
                            replyToComment = nil
                            
                            // 触觉反馈
                            let generator = UIImpactFeedbackGenerator(style: .light)
                            generator.impactOccurred()
                        }) {
                            Image(systemName: "arrow.up.circle.fill")
                                .font(.system(size: 26))
                                .foregroundColor(.blue)
                        }
                        .padding(.trailing, 8)
                    }
                }
            }
            .padding(.horizontal, 16)
            .padding(.vertical, 10)
            .background(Color(.systemBackground))
            .overlay(
                Rectangle()
                    .frame(height: 0.5)
                    .foregroundColor(Color(.systemGray4))
                    .opacity(0.5),
                alignment: .top
            )
        }
    }
    
    // 设置回复
    func setReplyTo(_ comment: UserCommentModel) {
        withAnimation {
            isReplying = true
            replyToComment = comment
        }
    }
}
