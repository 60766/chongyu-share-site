import Foundation
import Combine
import UIKit

/**
 * AI内容生成器
 * 负责使用API生成五种类型的内容
 */
class AIContentGenerator {
    // 单例实例
    static let shared = AIContentGenerator()
    
    // MARK: - 私有属性
    private init() {}
    
    // 取消令牌
    private var cancellables = Set<AnyCancellable>()
    
    // MARK: - 虫洞共鸣内容生成
    
    /**
     * 生成虫洞共鸣内容
     * @param figure 历史人物
     * @param situation 情境
     * @param expectation 期望
     * @return Future<String, Error>
     */
    func generateResonanceContent(
        figure: String,
        situation: String,
        expectation: String
    ) -> Future<String, Error> {
        return Future { promise in
            let prompt = """
            请以\(figure)的风格，创作一篇简短的思考文章，主题关于\(situation)，读者期望获得\(expectation)。
            文章应体现\(figure)的思维方式、价值观和语言特点，展示跨越时空的思考深度。
            内容应包含：
            1. 对\(situation)的独特见解
            2. 与读者建立情感共鸣
            3. 提供新颖的思考角度
            4. 使用\(figure)特有的表达方式
            
            文章篇幅控制在150字以内，保持简洁明了，使用\(figure)特有的表达和思考方式。不需要签名或引用。
            """
            
            self.generateContent(prompt: prompt)
                .sink(
                    receiveCompletion: { completion in
                        if case .failure(let error) = completion {
                            promise(.failure(error))
                        }
                    },
                    receiveValue: { content in
                        promise(.success(content))
                    }
                )
                .store(in: &self.cancellables)
        }
    }
    
    // MARK: - 虫洞共鸣内容生成（增强版）
    
    /**
     * 生成虫洞共鸣内容（真实情感连接版本）
     * @param figure 历史人物
     * @param situation 情境 - 用户当前面临的处境或问题
     * @param expectation 期望 - 用户希望获得的启发或答案
     * @param keyword 关键词（可选）- 用户特别关注的方面
     * @return Future<String, Error>
     */
    func generateEnhancedResonanceContent(
        figure: String,
        situation: String,
        expectation: String,
        keyword: String? = nil
    ) -> Future<String, Error> {
        return Future { promise in
            var promptKeyword = ""
            if let keyword = keyword, !keyword.isEmpty {
                promptKeyword = "，写作重点是\"\(keyword)\""
            }
            
            // 构建个性化内容生成提示词，让AI自行发挥对历史人物的理解
            let prompt = """
            【虫洞共鸣：历史人物的心灵分享】
            
            你是\(figure)，正在社交媒体上与现代人分享关于"\(situation)"（情境）与"\(expectation)"（期望）的见解。请特别关注如何在这样的情境下帮助读者获得他们期望的"\(expectation)"。
            
