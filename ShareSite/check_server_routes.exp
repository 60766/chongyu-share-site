#!/usr/bin/expect -f

set timeout 30
set password "3Qq123456."
set server_ip "121.40.184.29"

puts "🔍 检查服务器路由配置...\n"

# 检查server.js中的路由
spawn ssh root@${server_ip} "grep -n 'verify-receipt\\|purchase/confirm' /var/www/chongyu-backend/server.js"
expect {
    "password:" {
        send "$password\r"
        expect eof
    }
    timeout {
        puts "❌ 超时"
        exit 1
    }
}

