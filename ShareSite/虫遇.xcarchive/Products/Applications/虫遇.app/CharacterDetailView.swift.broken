/**
 * 互动记录视图
 * 显示与角色的历史对话记录
 */
private struct InteractionView: View {
    let character: Character
    let conversations: [DisplayConversation]
    let onConversationTap: (DisplayConversation) -> Void
    @State private var showNewConversation = false
    
    var body: some View {
        ScrollView {
                VStack(spacing: 16) {
                // 开始对话按钮
                Button(action: {
                    showNewConversation = true
                }) {
                        HStack {
                        Image(systemName: "bubble.right.fill")
                            .font(.system(size: 18))
                            .foregroundColor(.white)
                            
                            Text("开始对话")
                            .font(.system(size: 16, weight: .medium))
                        .foregroundColor(.white)
                    }
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 14)
                    .background(Color.blue)
                        .cornerRadius(8)
                    }
                .buttonStyle(PlainButtonStyle())
                .padding(.horizontal)
                .padding(.top, 12)
                
                // 对话历史列表
                if conversations.isEmpty {
                    // 空状态视图
                    VStack(spacing: 12) {
                        Image(systemName: "bubble.left.and.bubble.right")
                            .font(.system(size: 30))
                            .foregroundColor(.gray.opacity(0.5))
                            .padding(.bottom, 4)
                        
                        Text("暂无对话历史")
                            .font(.system(size: 15, weight: .medium))
                            .foregroundColor(.secondary)
                        
                        Text("点击上方按钮开始新对话")
                            .font(.system(size: 14))
                            .foregroundColor(.secondary.opacity(0.8))
                }
                .frame(maxWidth: .infinity)
                .padding(.vertical, 60)
            } else {
                    // 对话历史列表
                    VStack(spacing: 0) {
                ForEach(conversations) { conversation in
                            SimplifiedConversationRow(
                                character: character,
                                conversation: conversation,
                                onTap: { onConversationTap(conversation) }
                            )
                            
                            if conversation.id != conversations.last?.id {
            Divider()
                                    .padding(.leading, 70)
                            }
                        }
                    }
        .background(Color.white)
                    .cornerRadius(8)
                    .padding(.horizontal)
                }
                
                Spacer(minLength: 60)
            }
        }
        .sheet(isPresented: $showNewConversation) {
            Text("新对话界面（已简化）")
                .presentationDetents([.medium])
        }
    }
}

/**
 * 简化的对话行组件
 * 显示单条对话记录
 */
private struct SimplifiedConversationRow: View {
    let character: Character
    let conversation: DisplayConversation
    let onTap: () -> Void
    
    var body: some View {
        Button(action: onTap) {
                        HStack(spacing: 12) {
                // 头像
                Circle()
                    .fill(Color.gray.opacity(0.1))
                    .frame(width: 50, height: 50)
                    .overlay(
                        Text(String(character.name.prefix(1)))
                            .font(.system(size: 22))
                            .foregroundColor(.gray)
                    )
                
                // 对话内容
                            VStack(alignment: .leading, spacing: 4) {
                                Text(conversation.lastMessageContent)
                                    .font(.system(size: 14))
                    .foregroundColor(.primary)
                                    .lineLimit(1)
                
                    Text(formatDate(conversation.lastMessageTime))
                                    .font(.system(size: 12))
                                    .foregroundColor(.secondary)
                }
                
                Spacer()
                
                // 右箭头
                Image(systemName: "chevron.right")
                    .font(.system(size: 14))
                    .foregroundColor(.gray.opacity(0.6))
            }
            .padding(.vertical, 12)
            .padding(.horizontal, 16)
                    }
                    .buttonStyle(PlainButtonStyle())
                }
    
    // 格式化日期
    private func formatDate(_ date: Date) -> String {
        let formatter = DateFormatter()
        formatter.dateStyle = .short
        formatter.timeStyle = .none
        return formatter.string(from: date)
    }
}

/**
 * 添加简化的内容项组件
 * 用于显示带有标题和图标的内容块
 */
private struct SectionItem: View {
    let icon: String
    let title: String
    let content: String
    
    var body: some View {
        VStack(alignment: .leading, spacing: 12) {
            // 标题栏 - 精致的布局与对齐
            HStack(spacing: 8) {
                // 图标 - 优化视觉效果
                Image(systemName: icon)
                    .font(.system(size: 16, weight: .medium))
                    .foregroundColor(Color.blue.opacity(0.9))
                    .frame(width: 24, alignment: .center)
                
                // 标题 - 精确的字体和间距
                Text(title)
                    .font(.system(size: 16, weight: .semibold))
                    .foregroundColor(.primary)
            }
            .padding(.vertical, 8)
            
            // 内容区 - 优化文本渲染
            Text(content)
                .font(.system(size: 15))
                .foregroundColor(.primary.opacity(0.85))
                .lineSpacing(5)
                .padding(.bottom, 16)
                .fixedSize(horizontal: false, vertical: true)
            
            // 分隔线 - 精致渐变
            Rectangle()
                .fill(
                    LinearGradient(
                        gradient: Gradient(colors: [
                            Color.gray.opacity(0.1),
                            Color.gray.opacity(0.15),
                            Color.gray.opacity(0.1)
                        ]),
                        startPoint: .leading,
                        endPoint: .trailing
                    )
                )
                .frame(height: 0.5)
        }
        .padding(.top, 12)
    }
}

// 添加滚动指示器组件
private struct ScrollingPageIndicator: View {
    let character: Character
    @Binding var currentPage: Int
    let numberOfPages: Int
    
    var body: some View {
        let theme = CharacterTheme.forField(character.field)
        
        HStack(spacing: 5) { // 减少间距
            ForEach(0..<numberOfPages, id: \.self) { page in
                Circle()
                    .fill(currentPage == page ? theme.primary : Color.gray.opacity(0.2)) // 降低不活跃点的不透明度
                    .frame(width: 6, height: 6) // 减小尺寸
                    .scaleEffect(currentPage == page ? 1.2 : 1.0)
                    .animation(.spring(), value: currentPage)
            }
        }
        .padding(7) // 减少内边距
        .background(Color.white.opacity(0.75)) // 降低背景不透明度
        .cornerRadius(10) // 减小圆角
        .shadow(color: Color.black.opacity(0.05), radius: 2, x: 0, y: 1) // 减小阴影效果
    }
}

